; SPDX-License-Identifier: MIT
;
; familia: dinámica
; resumen: Sustain de arco: la nota entra suave, se queda a nivel fijo y puede pasar a su octava.
; resumen.en: Bow sustain: the note fades in, stays at a constant level and can move to its octave.
; resumen.zh-CN: 琴弓式延音：音符渐入，保持恒定音量，并可过渡到高八度。
; resumen.ja: 弓のようなサステイン：ノートはフェードインし、一定の音量を保ち、オクターブ上へ移れます。
;
; arco.sasm — Sustainer de tipo eBow. Un control automático de ganancia (AGC)
; mantiene la nota a nivel fijo mientras la cuerda decae. El AGC es un lazo de
; realimentación sin división: mide el pico de la salida y corrige la ganancia
; en proporción al error y a la propia ganancia. Así la ganancia cambia en
; decibelios por segundo y nunca cruza 0. Diseño propio, a partir del principio
; de los sustainers caseros y del eBow que se comentan en Guitarristas.info:
; la cuerda se mantiene a nivel constante, entra con un fundido y, en el modo
; armónico, salta a su octava.
;
; Cada muestra:
;   1. Dos envolventes de |x|: rápida (~2 ms) y lenta (~40 ms).
;   2. y = x·G, con G = 32·g. El pico de |y| es `envy`.
;   3. Ataque (rápida > 2·lenta + umbral): el fundido y el paso a la octava
;      caen a 0 en unos 5 ms. Así el golpe de púa no se oye.
;   4. Puerta abierta (lenta > umbral): el fundido sube hacia 1 con la
;      constante de pot1. El paso a la octava sube hacia pot3 en ~0,7 s.
;   5. Puerta cerrada: G se congela y el fundido baja a 0 en ~0,5 s. El
;      ruido no sube.
;   6. AGC (con la puerta abierta o en un ataque): e = objetivo − envy.
;      g += k·e·g, con k = 0,001 si e ≥ 0 y k = 0,004 si e < 0.
;      g queda entre 1/256 (×0,125) y el techo de pot0.
;   7. Voz = y + paso·(octava − y). La octava sale de un pitch shifter de doble
;      tap (+12). Luego, paso bajo (pot4), fundido y mezcla (pot2).
;
; pot0 = sustain       (techo de ganancia: 0 → ×2 · 1 → ×32)
; pot1 = subida        (fundido de entrada: 0 → unos 17 ms · 1 → unos 1,7 s)
; pot2 = mezcla        (0 → seco · 1 → solo el sustain)
; pot3 = octava alta   (modo armónico: 0 → fundamental · 1 → la nota pasa a su octava)
; pot4 = tono          (0 → abierto · 1 → oscuro)
; pot5 = umbral        (puerta: 0 → 0,003 · 1 → 0,05)
; sw   = mientras se pisa, la puerta baja a 1/8 y la nota se sostiene; al
;        soltar, la puerta vuelve y la salida se funde.

equ  w         2048            ; ventana del pitch shifter (muestras)
equ  objetivo  0.2             ; pico de salida que busca el AGC
equ  kup       0.001           ; velocidad de subida del AGC
equ  kdown     0.004           ; velocidad de bajada del AGC
equ  gmin      1/256           ; suelo de g (G = ×0,125)

equ  kwet     reg0
equ  kdry     reg1
equ  g        reg2
equ  envy     reg3
equ  envr     reg4
equ  envl     reg5
equ  techo    reg6
equ  umbral   reg7
equ  kfi      reg8
equ  fundido  reg9
equ  paso     reg10
equ  y        reg11
equ  lp       reg12
equ  tmp      reg13
equ  x        reg14
equ  ktono    reg15

mem  po    w + 3

lfo  0  ramp w

; ── inicialización: G = ×1 y rampa de +12 ────────────────────────────
        skp   run, inicio
        sof   0, 1/32
        wrax  g, 0
        sof   0, -2/w                   ; +12: rate = 2·(1 − 2)/w
        wrax  lfo0_rate, 0
inicio:
; ── controles ────────────────────────────────────────────────────────
include  comun/mezcla.sasm
        rdax  pot0, 0.9375              ; techo = 1/16 + 15/16·pot0
        sof   1.0, 0.0625
        wrax  techo, 0
        rdax  pot1, -1.0                ; kfi = 0,0012·(0,01 + 0,99·(1 − pot1)²)
        sof   1.0, 0.99997
        wrax  tmp, 1.0
        mulx  tmp
        sof   0.99, 0.01
        sof   0.0012, 0
        wrax  kfi, 0
        rdax  pot4, -0.9                ; ktono = 1 − 0,9·pot4
        sof   1.0, 0.99997
        wrax  ktono, 0
        rdax  sw, -0.875                ; umbral = (0,003 + 0,047·pot5)·(1 − 0,875·sw)
        sof   1.0, 0.99997
        wrax  tmp, 0
        rdax  pot5, 0.047
        sof   1.0, 0.003
        mulx  tmp
        wrax  umbral, 0
; ── 1. entrada y envolventes ─────────────────────────────────────────
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        wrax  x, 1.0
        absa
        rdfx  envr, 0.01
        wrax  envr, 1.0
        rdfx  envl, 0.0005
        wrax  envl, 0
; ── 2. y = x·32·g y su pico ──────────────────────────────────────────
        rdax  x, 1.0
        mulx  g
        sof   1.999, 0
        sof   1.999, 0
        sof   1.999, 0
        sof   1.999, 0
        sof   1.999, 0
        wrax  y, 0
        rdax  envy, 0.9998
        maxx  y, 1.0
        wrax  envy, 0
; ── 3. ataque: fundido y paso caen a 0 ───────────────────────────────
        rdax  envr, 1.0
        rdax  envl, -2.0
        rdax  umbral, -1.0
        skp   neg, sin_ataque
        clr
        rdfx  fundido, 0.004
        wrax  fundido, 0
        rdfx  paso, 0.004
        wrax  paso, 0
        skp   zro, agc
sin_ataque:
; ── 4 y 5. puerta ────────────────────────────────────────────────────
        clr
        rdax  envl, 1.0
        rdax  umbral, -1.0
        skp   gez, abierta
        clr                             ; cerrada: fundido → 0, G congelada
        rdfx  fundido, 1/32768
        sof   1.0, -1/32768
        skp   gez, cerrada_fin
        clr
cerrada_fin:
        wrax  fundido, 0
        skp   zro, voz
abierta:
        clr                             ; fundido += kfi·(1 − fundido)
        rdax  fundido, -1.0
        sof   1.0, 0.99997
        mulx  kfi
        rdax  fundido, 1.0
        wrax  fundido, 0
        rdax  pot3, 1.0                 ; paso → pot3 en ~0,7 s
        rdfx  paso, 2/65536
        wrax  paso, 0
; ── 6. AGC: g += k·(objetivo − envy)·g ───────────────────────────────
agc:
        rdax  envy, -1.0
        sof   1.0, objetivo
        skp   neg, agc_baja
        sof   kup, 0
        skp   gez, agc_aplica
agc_baja:
        sof   kdown, 0
agc_aplica:
        mulx  g
        rdax  g, 1.0
        wrax  g, 1.0
        rdax  techo, -1.0               ; techo
        skp   neg, agc_suelo
        clr
        rdax  techo, 1.0
        wrax  g, 0
agc_suelo:
        clr                             ; suelo
        rdax  g, 1.0
        sof   1.0, -gmin
        skp   gez, voz
        clr
        sof   0, gmin
        wrax  g, 0
; ── 7. voz: fundamental → octava, tono, fundido y mezcla ─────────────
voz:
        clr
        rdax  y, 1.0
        wra   po, 0
        cho   po + 1, 1.0, lfo0, na
        cho   po + 1, 1.0, lfo0, na|media
        rdax  y, -1.0
        mulx  paso
        rdax  y, 1.0
        rdax  lp, -1.0                  ; lp += ktono·(voz − lp)
        mulx  ktono
        rdax  lp, 1.0
        wrax  lp, 1.0
        mulx  fundido
        mulx  kwet
        wrax  tmp, 0
        rdax  adcl, 1.0
        mulx  kdry
        rdax  tmp, 1.0
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  tmp, 1.0
        wrax  dacr, 0
