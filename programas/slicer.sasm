; SPDX-License-Identifier: MIT
;
; familia: modulación
; resumen: Corta el sonido en pulsos rítmicos, como una puerta que abre y cierra.
; resumen.en: It cuts the sound into rhythmic pulses, like a gate that opens and closes.
; resumen.zh-CN: 将声音切成有节奏的脉冲，如同开合的门。
; resumen.ja: 音をリズミカルなパルスに刻みます。開閉するゲートのように。
;
; slicer.sasm — Una rampa por software sube de −1 a 1 y vuelve a −1. Mientras
; está por debajo de 2·ciclo − 1, la puerta está abierta. Un paso bajo corto
; quita los clics. Diseño propio.
;
; pot0 = velocidad     (0 → 1 pulso/s · 1 → 16 pulsos/s)
; pot1 = profundidad   (0 → nada · 1 → silencio entre pulsos)
; pot2 = ciclo         (0 → pulsos cortos, 10 % · 1 → largos, 90 %)
; pot3 = suavizado     (0 → corte seco · 1 → ~5 ms)

equ  rampa    reg0
equ  vel      reg1
equ  ciclo    reg2
equ  g        reg3
equ  ks       reg4
equ  tmp_obj  reg5

        rdax  pot0, 2*15/48828.125      ; la rampa sube 2 por pulso: vel = 2·f/fs
        sof   1.0, 2*1/48828.125
        wrax  vel, 0
        rdax  pot2, 1.0                 ; umbral = 2·ciclo − 1, ciclo de 0,1 a 0,9
        sof   1.6, -0.8
        wrax  ciclo, 0
        rdax  pot3, -0.03               ; ks de 0,031 (~0,7 ms) a 0,001 (~20 ms)
        sof   1.0, 0.031
        wrax  ks, 0
; ── rampa: sube vel; al llegar arriba vuelve a −1 ────────────────────
        rdax  rampa, 1.0
        rdax  vel, 1.0
        wrax  rampa, 1.0
        sof   1.0, -0.999
        skp   neg, decidir
        sof   0, -0.99997
        wrax  rampa, 0
decidir:
        clr
        rdax  rampa, 1.0
        rdax  ciclo, -1.0
        skp   neg, abierta
        clr                             ; cerrada: objetivo 1 − prof
        rdax  pot1, -1.0
        sof   1.0, 0.99997
        skp   gez|neg, suavizar         ; siempre: 1 − pot1 puede salir −0,00003
abierta:
        sof   0, 0.99997
suavizar:
        wrax  tmp_obj, 0
        rdax  g, -1.0
        rdax  tmp_obj, 1.0
        mulx  ks
        rdax  g, 1.0
        wrax  g, 0
        rdax  adcl, 1.0
        mulx  g
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  g
        wrax  dacr, 0
