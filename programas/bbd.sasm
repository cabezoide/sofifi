; SPDX-License-Identifier: MIT
;
; familia: delay
; resumen: Eco analógico oscuro: cada repetición pierde agudos y se satura.
; resumen.en: Dark analog echo: each repeat loses treble and saturates.
; resumen.zh-CN: 暗色的模拟回声：每次重复都会损失高音并产生饱和。
; resumen.ja: 暗いアナログのエコー：繰り返すたびに高域が減り、飽和します。
;
; bbd.sasm — Imita un delay de «bucket brigade» (BBD): un retardo corto con
; dos pasos bajo en el bucle (~2,5 kHz), saturación suave (CLIP) y un leve
; vaivén de tono (LFO senoidal sobre una memoria corta). Diseño propio
; (docs/investigacion/INVESTIGACION.md §4.3).
;
; pot0 = tiempo           (0 → 20 ms · 1 → 300 ms)
; pot1 = realimentación   (0 → un eco · 1 → 1, contenido por CLIP)
; pot2 = mezcla           (0 → seco · 1 → solo ecos)
; pot3 = modulación       (0 → quieto · 1 → ±0,15 ms)

equ  et    6836
equ  base  977
equ  em    8                  ; excursión de la modulación

equ  trate    lfo0_rate
equ  tdepth   lfo0_depth
equ  tpot     pot0
equ  kwet     reg0
equ  kdry     reg1
equ  tiempo   reg2
equ  lp1      reg3
equ  lp2      reg4
equ  eco      reg5
equ  ecow     reg6
equ  tmp      reg7

mem  bb    base + 2*et + 3
mem  md    2*em + 4

lfo  0  sin  et
lfo  1  sin  em

        wrax  trate, 0
        skp   run, inicio
        sof   0, 0.5
        wrax  trate, 0
        sof   0, 1/512
        wrax  tmp, 0
        rdax  tmp, 1024*0.7/48828.125   ; LFO1 a 0,7 Hz
        wrax  lfo1_rate, 0
inicio:
include  comun/mezcla.sasm
include  comun/tiempo.sasm
        rdax  pot3, 1.0
        wrax  lfo1_depth, 0
; ── eco: retardo, vaivén y dos pasos bajo ────────────────────────────
        cho   bb + base, 1.0, lfo0
        wra   md, 0
        cho   md + 1, 1.0, lfo1
        rdfx  lp1, 0.28
        wrax  lp1, 1.0
        rdfx  lp2, 0.28
        wrax  lp2, 1.0
        wrax  eco, 1.0
; ── realimentación con saturación ────────────────────────────────────
        mulx  pot1
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        sof   2/3, 0
        clip
        wra   bb, 0
; ── salida ───────────────────────────────────────────────────────────
        rdax  eco, 1.0
        mulx  kwet
        wrax  ecow, 0
        rdax  adcl, 1.0
        mulx  kdry
        rdax  ecow, 1.0
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  ecow, 1.0
        wrax  dacr, 0
