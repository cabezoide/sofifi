; SPDX-License-Identifier: MIT
;
; familia: delay
; resumen: Eco de cinta de 0,18 a 0,85 s con wow, flutter y saturación.
; resumen.en: Tape echo from 0.18 to 0.85 s with wow, flutter and saturation.
; resumen.zh-CN: 0.18 至 0.85 秒的磁带回声，带 wow、flutter 和饱和。
; resumen.ja: 0.18〜0.85 秒のテープエコー。ワウ、フラッター、飽和付き。
;
; cinta.sasm — Eco de cinta de 0,18 a 0,85 s, con wow, flutter y saturación en
; el bucle. Diseño propio (docs/investigacion/INVESTIGACION.md §1.1).
;
; El tiempo de eco sale de un LFO senoidal parado: en la muestra 0 avanza un
; cuarto de vuelta y después su rate es 0. Así su forma vale 1 y el retardo del
; CHO es base + E·(1 + lfo0_depth). pot0 mueve lfo0_depth con un paso bajo: al
; girar el mando, el tono del eco se desliza, como en una cinta de verdad.
;
; Cada muestra:
;   1. Lee la cinta (CHO sobre el LFO parado).
;   2. Wow (0,55 Hz) y flutter (6,3 Hz): dos memorias cortas leídas con CHO.
;   3. Filtros de la cabeza: paso bajo fijo y paso alto suave.
;   4. Escribe en la cinta la entrada más el eco por la realimentación, pasado
;      por CLIP (saturación suave de pendiente 1).
;
; pot0 = tiempo          (0 → 0,18 s · 1 → 0,85 s)
; pot1 = realimentación  (0 → un eco · 1 → casi infinita)
; pot2 = mezcla          (0 → seco · 1 → solo eco)
; pot3 = wow y flutter   (0 → nada · 1 → cinta gastada)

equ  et    16384              ; excursión del LFO del tiempo: 2·et muestras de recorrido
equ  base  8736               ; retardo mínimo (0,18 s); el máximo es base + 2·et (0,85 s)
equ  ew    40                 ; wow: excursión en muestras (≈ 0,3 % de tono)
equ  ef    2                  ; flutter: excursión en muestras (≈ 0,15 % de tono)
equ  ktono 0.35               ; paso bajo de la cabeza (≈ 3,4 kHz)

equ  kwet     reg0
equ  kdry     reg1
equ  tmp      reg2
equ  tiempo   reg3
equ  lp       reg4
equ  hp       reg5
equ  eco      reg6
equ  ecow     reg7

mem  cin   base + 2*et + 3
mem  wow   2*ew + 3
mem  flu   2*ef + 3

lfo  0  sin  et
lfo  1  sin  ew
lfo  2  sin  ef

; ── LFO del tiempo: rate 0 en cada muestra, salvo en la inicialización ──
        wrax  lfo0_rate, 0              ; ACC vale 0 al empezar la muestra
; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
        sof   0, 0.5                    ; rate = 2^22: un cuarto de vuelta en una muestra
        wrax  lfo0_rate, 0
        sof   0, 1/512                  ; tmp = 2^-9 para fijar frecuencias finas
        wrax  tmp, 0
        rdax  tmp, 1024*0.55/48828.125  ; LFO1 (wow) a 0,55 Hz (rate = 2f/fs)
        wrax  lfo1_rate, 0
        rdax  tmp, 1024*6.3/48828.125   ; LFO2 (flutter) a 6,3 Hz
        wrax  lfo2_rate, 0
inicio:
; ── controles ────────────────────────────────────────────────────────
include  comun/mezcla.sasm
        sof   0, -1.0                   ; objetivo = 2·pot0 − 1, en [−1, 1)
        rdax  pot0, 1.999
        rdfx  tiempo, 0.0005            ; deslizamiento de ~40 ms
        wrax  tiempo, 1.0
        wrax  lfo0_depth, 0
        rdax  pot3, 1.0
        wrax  lfo1_depth, 1.0
        wrax  lfo2_depth, 0
; ── 1 y 2. cinta, wow y flutter ──────────────────────────────────────
        cho   cin + base, 1.0, lfo0
        wra   wow, 0
        cho   wow + 1, 1.0, lfo1
        wra   flu, 0
        cho   flu + 1, 1.0, lfo2
; ── 3. cabeza: paso bajo y paso alto (x − paso bajo lento) ───────────
        rdfx  lp, ktono
        wrax  lp, 1.0
        rdfx  hp, 0.004
        wrax  hp, -1.0
        rdax  lp, 1.0
        wrax  eco, 1.0
; ── 4. realimentación con saturación y escritura ─────────────────────
        mulx  pot1
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        sof   2/3, 0                    ; curva_suave(2x/3): pendiente 1, techo ±1
        clip
        wra   cin, 0
; ── salida ───────────────────────────────────────────────────────────
        rdax  eco, 1.0
        mulx  kwet
        wrax  ecow, 0
        rdax  adcl, 1.0
        mulx  kdry
        rdax  ecow, 1.0
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  ecow, 1.0
        wrax  dacr, 0
