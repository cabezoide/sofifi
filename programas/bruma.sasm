; SPDX-License-Identifier: MIT
;
; familia: delay
; resumen: Eco de cuatro cabezas que se difumina en cada vuelta hasta volverse reverb.
; resumen.en: A four-head echo that blurs on each turn until it becomes a reverb.
; resumen.zh-CN: 四磁头回声，每一轮都更模糊，直到变成混响。
; resumen.ja: 4 ヘッドのエコー。一巡ごとにぼやけ、やがてリバーブになります。
;
; bruma.sasm — Eco de cinta de cuatro cabezas (0,18 · 0,37 · 0,55 · 0,74 s) con
; difusión dentro de la realimentación. La última cabeza vuelve a la línea a
; través de tres allpass: cada repetición es más difusa que la anterior, y
; tras unas vueltas el eco es una nube. Las cabezas 1 y 3 van a la
; izquierda, la 2 a la derecha y la 4 a los dos lados. Un LFO senoidal lento
; mueve las cuatro lecturas (wow). Idea de los ecos de varias cabezas con difusión
; (docs/investigacion/INVESTIGACION.md §4.3). Diseño propio.
;
; pot0 = difusión         (0 → ecos nítidos · 1 → cada vuelta se difumina)
; pot1 = realimentación   (0 → una vuelta · 1 → 0,85)
; pot2 = mezcla           (0 → seco · 1 → solo ecos)
; pot3 = cabezas          (0 → solo la cuarta · 1 → las cuatro)

equ  ew    12                 ; wow: ±0,25 ms
equ  h1    8789               ; 0,18 s
equ  h2    18066              ; 0,37 s
equ  h3    26855              ; 0,55 s
equ  h4    36133              ; 0,74 s
equ  ka    0.6                ; difusión de cada allpass

equ  kwet     reg0
equ  kdry     reg1
equ  tmp      reg2
equ  c4       reg3
equ  fb       reg4
equ  lp       reg5
equ  ei       reg6
equ  ed       reg7

mem  cab   h4 + 2*ew + 3
mem  ap1   1153
mem  ap2   1777
mem  ap3   2459

lfo  0  sin  ew

; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
        sof   0, 1/512                  ; tmp = 2^-9 para fijar frecuencias finas
        wrax  tmp, 0
        rdax  tmp, 1024*0.6/48828.125   ; LFO0 a 0,6 Hz
        wrax  lfo0_rate, 0
        sof   0, 0.99
        wrax  lfo0_depth, 0
inicio:
include  comun/mezcla.sasm
; ── cabezas ──────────────────────────────────────────────────────────
        cho   cab + h4 - ew, 1.0, lfo0
        wrax  c4, 0
        cho   cab + h1 - ew, 0.7, lfo0
        cho   cab + h3 - ew, 0.6, lfo0
        mulx  pot3
        rdax  c4, 0.7
        wrax  ei, 0
        cho   cab + h2 - ew, 0.65, lfo0
        mulx  pot3
        rdax  c4, 0.7
        wrax  ed, 0
; ── realimentación: fb = c4 + pot0·(allpass(c4) − c4) ────────────────
        rdax  c4, 1.0
        rda   ap1#, ka
        wrap  ap1, -ka
        rda   ap2#, ka
        wrap  ap2, -ka
        rda   ap3#, ka
        wrap  ap3, -ka
        rdax  c4, -1.0
        mulx  pot0
        rdax  c4, 1.0
        rdfx  lp, 0.4                   ; la cinta pierde agudos en cada vuelta
        wrax  lp, 1.0
        mulx  pot1
        sof   0.85, 0
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        wra   cab, 0
; ── salida ───────────────────────────────────────────────────────────
        rdax  ei, 1.0
        mulx  kwet
        wrax  ei, 0
        rdax  adcl, 1.0
        mulx  kdry
        rdax  ei, 1.0
        wrax  dacl, 0
        rdax  ed, 1.0
        mulx  kwet
        wrax  ed, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  ed, 1.0
        wrax  dacr, 0
