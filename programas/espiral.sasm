; SPDX-License-Identifier: MIT
;
; familia: pitch
; resumen: Reverb cuya cola sube o baja de tono en espiral, con un intervalo a cada lado.
; resumen.en: A reverb whose tail spirals up or down in pitch, with one interval on each side.
; resumen.zh-CN: 尾音以螺旋方式升高或降低音高的混响，左右各有一个音程。
; resumen.ja: 残響がらせん状に上昇または下降するリバーブ。左右で別々の音程を持ちます。
;
; espiral.sasm — Cada lado tiene su propio bucle de regeneración. En cada vuelta,
; la señal pasa por un pitch shifter, tres allpass, un paso bajo y un paso alto.
; Después entra en una línea de retardo y vuelve al principio del bucle. Así,
; cada vuelta transpone otra vez la cola y la difumina un poco más. La izquierda
; usa el intervalo de pot0 y la derecha el de pot1: las dos espirales se separan.
; El paso bajo saca la espiral que sube y el paso alto la que baja.
; Un CLIP acota la entrada del shifter. Con el pedal pisado, la realimentación
; vale 1,4 y una parte de cada vuelta salta el shifter. Esa parte no se va de
; la banda, y el bucle autooscila. El CLIP fija el techo. La salida de cada
; bucle entra en una nube ligera: dos allpass y un retardo con realimentación,
; una por lado.
;
; pot0 = intervalo        (izquierda: −12 · −7 · −5 · +5 · +7 · +12, seis tramos)
; pot1 = segunda voz      (derecha: −12 · −7 · −5 · +5 · +7 · +12, seis tramos)
; pot2 = mezcla           (0 → seco · 1 → solo la espiral)
; pot3 = tiempo           (retardo de cada vuelta: 0 → 45 ms · 1 → 0,3 s)
; pot4 = realimentación   (0 → 0,2, unas vueltas · 1 → 0,9, cola larga)
; pot5 = decay            (nube: 0 → 0,3 · 1 → 0,9)
; sw   = autooscilación mientras se pisa, acotada por CLIP
;
; Diseño propio, a partir del principio de los parches ZOIA «Downward spiral»
; y «Abyss»: una línea de regeneración con un shifter, un difusor y un paso
; bajo dentro del lazo, un intervalo distinto en cada canal, una reverb a la
; salida y una autooscilación momentánea.

equ  w     4096               ; ventana de los pitch shifters
equ  et    6336               ; recorrido del tiempo: 2·et muestras
equ  base  49                 ; retardo mínimo de la línea (1 ms)
equ  kd    0.6                ; difusión de los allpass del bucle
equ  kn    0.6                ; difusión de los allpass de la nube
equ  ksost 0.75               ; parte sin transponer con el pedal
equ  kfb   1.4                ; ganancia del bucle con kmag = 1

equ  trate    lfo2_rate
equ  tdepth   lfo2_depth
equ  tpot     pot3
equ  kwet     reg0
equ  kdry     reg1
equ  tmp      reg2
equ  tiempo   reg3
equ  kmag     reg4
equ  kdec     reg5
equ  entrada  reg6
equ  lpl      reg7
equ  lpr      reg8
equ  bajol    reg9
equ  bajor    reg10
equ  yl       reg11
equ  yr       reg12
equ  nubel    reg13
equ  nuber    reg14
equ  amol     reg15
equ  amor     reg16
equ  sall     reg17
equ  salr     reg18
equ  sostl    reg19
equ  sostr    reg20

mem  pl    w + 3
mem  pr    w + 3
mem  dl    base + 2*et + 3
mem  dr    base + 2*et + 3
mem  dfl1  149
mem  dfl2  211
mem  dfl3  337
mem  dfr1  163
mem  dfr2  229
mem  dfr3  359
mem  nal1  719
mem  nal2  1031
mem  ntl   1987
mem  nar1  797
mem  nar2  1123
mem  ntr   2111

lfo  0  ramp w
lfo  1  ramp w
lfo  2  sin  et

        wrax  trate, 0                  ; ACC vale 0 al empezar la muestra
; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
        sof   0, 1/512                  ; tmp = 2^-9
        wrax  tmp, 0
        sof   0, 0.5                    ; un cuarto de vuelta: forma 1
        wrax  trate, 0
inicio:
; ── controles ────────────────────────────────────────────────────────
include  comun/mezcla.sasm
include  comun/tiempo.sasm
include  comun/intervalo.sasm
        ; intervalo de la derecha: los mismos seis tramos con pot1 y el LFO1
        rdax  pot1, 1.0
        sof   1.0, -1/6
        skp   neg, der_m12
        sof   1.0, -1/6
        skp   neg, der_m7
        sof   1.0, -1/6
        skp   neg, der_m5
        sof   1.0, -1/6
        skp   neg, der_p5
        sof   1.0, -1/6
        skp   neg, der_p7
        clr                             ; +12: razón 2
        rdax  tmp, -0.25
        skp   gez|neg, der_fin
der_m12:
        clr                             ; −12: razón 0,5
        rdax  tmp, 0.125
        skp   gez|neg, der_fin
der_m7:
        clr                             ; −7: razón 0,66742
        rdax  tmp, (1 - 0.66742)/4
        skp   gez|neg, der_fin
der_m5:
        clr                             ; −5: razón 0,74915
        rdax  tmp, (1 - 0.74915)/4
        skp   gez|neg, der_fin
der_p5:
        clr                             ; +5: razón 1,33484
        rdax  tmp, (1 - 1.33484)/4
        skp   gez|neg, der_fin
der_p7:
        clr                             ; +7: razón 1,49831
        rdax  tmp, (1 - 1.49831)/4
der_fin:
        wrax  lfo1_rate, 0
        ; realimentación: kmag = max((0,2 + 0,7·pot4)/kfb, sw); el ×kfb va en un coeficiente
        rdax  pot4, 0.7/kfb
        sof   1.0, 0.2/kfb
        maxx  sw, 1.0
        wrax  kmag, 0
        rdax  pot5, 0.6                 ; decay de la nube
        sof   1.0, 0.3
        wrax  kdec, 0
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        wrax  entrada, 0
; ── bucle izquierdo ──────────────────────────────────────────────────
        cho   dl + base, 1.0, lfo2      ; la vuelta anterior, retrasada
        mulx  kmag
        sof   kfb, 0
        rdax  entrada, 1.0
        sof   2/3, 0                    ; curva_suave(2x/3): pendiente 1, techo ±1
        clip
        wra   pl, 1.0
        mulx  sw                        ; con el pedal, parte de la vuelta no se transpone
        wrax  sostl, 0
        cho   pl + 1, 1.0, lfo0, na
        cho   pl + 1, 1.0, lfo0, na|media
        rdax  sostl, ksost
        rda   dfl1#, kd
        wrap  dfl1, -kd
        rda   dfl2#, kd
        wrap  dfl2, -kd
        rda   dfl3#, kd
        wrap  dfl3, -kd
        rdfx  lpl, 0.35                 ; paso bajo de unos 3,4 kHz
        wrax  lpl, 1.0
        rdfx  bajol, 0.01               ; bajol sigue a lpl por debajo de ~75 Hz
        wrax  bajol, -1.0
        rdax  lpl, 1.0                  ; lpl − bajol: paso alto
        wrax  yl, 1.0
        wra   dl, 0
; ── bucle derecho ────────────────────────────────────────────────────
        cho   dr + base, 1.0, lfo2
        mulx  kmag
        sof   kfb, 0
        rdax  entrada, 1.0
        sof   2/3, 0
        clip
        wra   pr, 1.0
        mulx  sw                        ; con el pedal, parte de la vuelta no se transpone
        wrax  sostr, 0
        cho   pr + 1, 1.0, lfo1, na
        cho   pr + 1, 1.0, lfo1, na|media
        rdax  sostr, ksost
        rda   dfr1#, kd
        wrap  dfr1, -kd
        rda   dfr2#, kd
        wrap  dfr2, -kd
        rda   dfr3#, kd
        wrap  dfr3, -kd
        rdfx  lpr, 0.35
        wrax  lpr, 1.0
        rdfx  bajor, 0.01
        wrax  bajor, -1.0
        rdax  lpr, 1.0
        wrax  yr, 1.0
        wra   dr, 0
; ── nube izquierda: yl + kdec·cola → dos allpass → amortiguación → retardo ──
        rda   ntl#, 1.0
        mulx  kdec
        rdax  yl, 0.5
        rda   nal1#, kn
        wrap  nal1, -kn
        rda   nal2#, kn
        wrap  nal2, -kn
        wrax  nubel, 1.0
        rdfx  amol, 0.5
        wrax  amol, 1.0
        wra   ntl, 0
; ── nube derecha ─────────────────────────────────────────────────────
        rda   ntr#, 1.0
        mulx  kdec
        rdax  yr, 0.5
        rda   nar1#, kn
        wrap  nar1, -kn
        rda   nar2#, kn
        wrap  nar2, -kn
        wrax  nuber, 1.0
        rdfx  amor, 0.5
        wrax  amor, 1.0
        wra   ntr, 0
; ── salida: la espiral y la nube, mezcladas con el seco ──────────────
        rdax  yl, 0.6
        rdax  nubel, 0.8
        mulx  kwet
        wrax  sall, 0
        rdax  yr, 0.6
        rdax  nuber, 0.8
        mulx  kwet
        wrax  salr, 0
        rdax  adcl, 1.0
        mulx  kdry
        rdax  sall, 1.0
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  salr, 1.0
        wrax  dacr, 0
