; SPDX-License-Identifier: MIT
;
; familia: pitch
; resumen: Cada nota se abre en un arpegio transpuesto (1-3-5-8) que cae en una reverb.
; resumen.en: Each note opens into a transposed arpeggio (1-3-5-8) that falls into a reverb.
; resumen.zh-CN: 每个音都展开成移调的琶音（1-3-5-8），落入混响之中。
; resumen.ja: 各音が移調されたアルペジオ（1-3-5-8）に開き、リバーブへ落ちていきます。
;
; arpegio.sasm — Un contador de pasos recorre las notas del arpegio. En cada
; paso, una compuerta suave abre una voz durante el 70 % del paso. El paso 1
; es la nota tocada. Los pasos 2, 3 y 4 salen de un solo pitch shifter:
; el contador cambia su intervalo (+4 o +3, +7 y +12 semitonos). El cambio
; ocurre con la compuerta cerrada, así que no hace clic. Un pasabanda limpia
; la entrada antes del shifter. La voz entra en un eco que dura un paso:
; la repetición de una nota suena con la nota siguiente, y las notas se
; apilan en un acorde. El eco entra en una reverb ligera: dos allpass y un
; tanque de dos ramas. La reverb solo recibe notas pasadas: así la nota que
; suena no forma un peine con su propia cola.
; Mientras se pisa el footswitch, el eco deja de recibir notas y repite lo que
; tiene con regeneración casi total.
; Diseño propio, a partir del principio de los ecos con pitch en arpegio que se
; funden en una reverb (parche ZOIA «Arpverb Unplugged» y programa FV-1
; «Arpeggio»).
;
; pot0 = velocidad        (0 → un paso cada 0,6 s · 1 → cada 0,1 s)
; pot1 = notas            (tres tramos: 2 · 3 · 4 notas, es decir 1-3 · 1-3-5 · 1-3-5-8)
; pot2 = mezcla           (0 → seco · 1 → solo efecto)
; pot3 = modo             (< 0,5 → mayor, +4 · ≥ 0,5 → menor, +3)
; pot4 = eco              (0 → una repetición · 1 → realimentación 0,85)
; pot5 = decay            (0 → 0,35 · 1 → 0,95, la reverb)
; sw   = congela el eco   (pisado: sin notas nuevas y regeneración 0,999)

equ  w     4096               ; ventana del pitch shifter
equ  base  4883               ; paso y eco mínimos (0,1 s)
equ  et    12207              ; recorrido del tiempo: 2·et muestras (hasta 0,6 s)
equ  tmax  base + 2*et        ; paso y eco máximos (0,6 s)
equ  cinc  64/tmax*512        ; 64·incremento con el paso máximo, en unidades de tmp
equ  kap   0.6                ; difusión de los allpass de entrada
equ  ktq   0.5                ; difusión de los allpass del tanque

equ  kwet     reg0
equ  kdry     reg1
equ  tmp      reg2
equ  sub      reg3            ; fase dentro del paso, [−0,5, 0,5)
equ  paso     reg4            ; paso del arpegio: 0 · 0,25 · 0,5 · 0,75
equ  nq       reg5            ; umbral de vuelta del contador
equ  raiz     reg6            ; ≈1 en el paso 1 (la nota tocada), 0 en el resto
equ  puerta   reg7            ; compuerta suavizada
equ  hpz      reg8            ; estado del paso alto del pasabanda
equ  lpz      reg9            ; estado del paso bajo del pasabanda
equ  sh       reg10           ; salida del pitch shifter
equ  voz      reg11           ; voz del arpegio
equ  envio    reg12           ; voz que entra en el eco
equ  kfb      reg13           ; realimentación del eco
equ  eco      reg14           ; salida del eco
equ  rin      reg15           ; entrada de la reverb
equ  kdec     reg16           ; decay del tanque
equ  lpa      reg17           ; damping de la rama A
equ  lpb      reg18           ; damping de la rama B
equ  wl       reg19
equ  wr       reg20
equ  tiempo   reg21           ; posición del tiempo: 1 (lento) a −1 (rápido)
equ  tn       reg22           ; duración del paso / 0,6 s
equ  inc      reg23           ; 64·incremento de sub por muestra (≈ tmp·cinc/tn)

mem  pe    w + 3
mem  de    base + 2*et + 3
mem  ap1   487
mem  ap2   727
mem  apa   1009
mem  apb   1307
mem  dla   3203
mem  dlb   2711

lfo  0  ramp w
lfo  1  sin  et

; ── LFO del tiempo: rate 0 en cada muestra, salvo en la inicialización ──
        wrax  lfo1_rate, 0              ; ACC vale 0 al empezar la muestra
; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
        sof   0, 0.5                    ; un cuarto de vuelta: la forma del LFO1 vale 1
        wrax  lfo1_rate, 0
        sof   0, 1/512                  ; tmp = 2^-9
        wrax  tmp, 0
        sof   0, -0.5                   ; el primer paso empieza entero
        wrax  sub, 0
        sof   0, 1.0                    ; el tiempo empieza ya en su sitio
        rdax  pot0, -1.999
        wrax  tiempo, 0
inicio:
; ── controles ────────────────────────────────────────────────────────
include  comun/mezcla.sasm
        rdax  pot1, 0.7497              ; nq = 0,2501 + 0,7497·pot1
        sof   1.0, 0.2501
        wrax  nq, 0
        rdax  pot4, 0.85                ; kfb = 0,85·pot4, o 0,999 con sw
        wrax  kfb, -1.0
        sof   1.0, 0.999
        mulx  sw
        rdax  kfb, 1.0
        wrax  kfb, 0
        rdax  pot5, 0.6
        sof   1.0, 0.35
        wrax  kdec, 0
; ── tiempo del paso, igual al del eco ────────────────────────────────
        sof   0, 1.0                    ; objetivo = 1 − 2·pot0
        rdax  pot0, -1.999
        rdfx  tiempo, 0.0005
        wrax  tiempo, 1.0
        wrax  lfo1_depth, 0.5           ; retardo = base + et·(1 + tiempo)
        sof   1.0, 0.5
        sof   (2*et)/tmax, base/tmax
        wrax  tn, 0                     ; tn = retardo / tmax
; inc tiende a tmp·cinc/tn: inc ← inc + (tmp·cinc − tn·inc)
        rdax  inc, 1.0
        mulx  tn
        sof   -1.0, 0
        rdax  tmp, cinc
        rdax  inc, 1.0
        wrax  inc, 0
; ── contador de pasos ────────────────────────────────────────────────
        rdax  inc, 1/64
        rdax  sub, 1.0
        wrax  sub, 1.0
        sof   1.0, -0.5
        skp   neg, cuenta
        sof   1.0, -0.5                 ; sub − 1: empieza otro paso
        wrax  sub, 0
        rdax  paso, 1.0
        sof   1.0, 0.25
        wrax  paso, 1.0
        rdax  nq, -1.0
        skp   neg, cuenta
        clr                             ; fin del arpegio: vuelta al paso 1
        wrax  paso, 0
cuenta:
        clr
; ── compuerta: abierta mientras sub < 0,2 ────────────────────────────
        rdax  sub, -1.0
        sof   1.999, 0.4                ; 2·(0,2 − sub)
        sof   1.999, 0
        sof   1.999, 0
        sof   1.999, 0
        sof   1.999, 0
        sof   1.999, 0                  ; ×64: satura a ±1
        sof   0.5, 0.5
        rdfx  puerta, 0.005             ; unos 4 ms
        wrax  puerta, 0
; ── raíz: ≈1 en el paso 1 ────────────────────────────────────────────
        rdax  paso, -1.0
        sof   1.999, 0.25               ; 2·(0,125 − paso)
        sof   1.999, 0
        sof   1.999, 0
        sof   0.5, 0.5
        wrax  raiz, 0
; ── intervalo del shifter según el paso ──────────────────────────────
; La rampa sube 2·(1 − razón)/4096 por muestra: coeficiente (1 − razón)/4.
        rdax  paso, 1.0
        sof   1.0, -0.375
        skp   neg, tercera              ; pasos 1 y 2
        sof   1.0, -0.25
        skp   neg, quinta               ; paso 3
        clr                             ; paso 4: +12, razón 2
        rdax  tmp, -0.25
        skp   gez|neg, intervalo
quinta:
        clr                             ; +7: razón 1,49831
        rdax  tmp, (1 - 1.49831)/4
        skp   gez|neg, intervalo
tercera:
        clr
        rdax  pot3, 1.0
        sof   1.0, -0.5
        skp   neg, mayor
        clr                             ; +3: razón 1,18921
        rdax  tmp, (1 - 1.18921)/4
        skp   gez|neg, intervalo
mayor:
        clr                             ; +4: razón 1,25992
        rdax  tmp, (1 - 1.25992)/4
intervalo:
        wrax  lfo0_rate, 0
; ── pasabanda (150 Hz – 3,5 kHz) y pitch shifter ─────────────────────
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        wrax  wl, 1.0
        rdfx  hpz, 0.0191
        wrax  hpz, -1.0
        rdax  wl, 1.0
        rdfx  lpz, 0.363
        wrax  lpz, 1.0
        wra   pe, 0
        cho   pe + 1, 1.0, lfo0, na
        cho   pe + 1, 1.0, lfo0, na|media
        wrax  sh, -1.0
        rdax  lpz, 1.0                  ; voz = sh + raiz·(pasabanda − sh)
        mulx  raiz
        rdax  sh, 1.0
        mulx  puerta
        wrax  voz, 0
; ── eco ──────────────────────────────────────────────────────────────
        rdax  sw, -1.0
        sof   1.0, 0.999
        mulx  voz
        wrax  envio, 0
        cho   de + base, 1.0, lfo1
        wrax  eco, 1.0
        mulx  kfb
        rdax  envio, 1.0
        sof   2/3, 0                    ; curva_suave(2x/3): pendiente 1, techo ±1
        clip
        wra   de, 0
; ── reverb ligera ────────────────────────────────────────────────────
        rdax  eco, 0.7                 ; la reverb recibe el eco: notas pasadas
        rda   ap1#, kap
        wrap  ap1, -kap
        rda   ap2#, kap
        wrap  ap2, -kap
        wrax  rin, 0
        rda   dlb#, 1.0                 ; rama A
        mulx  kdec
        rdax  rin, 1.0
        rdfx  lpa, 0.4
        wrax  lpa, 1.0
        rda   apa#, ktq
        wrap  apa, -ktq
        wra   dla, 0
        rda   dla#, 1.0                 ; rama B
        mulx  kdec
        rdax  rin, 1.0
        rdfx  lpb, 0.4
        wrax  lpb, 1.0
        rda   apb#, ktq
        wrap  apb, -ktq
        wra   dlb, 0
; ── salida ───────────────────────────────────────────────────────────
        rdax  voz, 0.8
        rdax  eco, 0.35
        rda   dla + 1201, 0.3
        rda   dlb + 397, 0.2
        mulx  kwet
        wrax  wl, 0
        rdax  voz, 0.8
        rdax  eco, 0.35
        rda   dlb + 1503, 0.3
        rda   dla + 2207, 0.2
        mulx  kwet
        wrax  wr, 0
        rdax  adcl, 1.0
        mulx  kdry
        rdax  wl, 1.0
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  wr, 1.0
        wrax  dacr, 0
