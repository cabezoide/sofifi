; SPDX-License-Identifier: MIT
;
; familia: modulación
; resumen: El tono sube y baja.
;
; vibrato.sasm — Vibrato: solo la señal retardada, con el retardo movido por un
; LFO senoidal. El tono sube y baja. Diseño propio.
;
; pot0 = velocidad     (0 → 2 Hz · 1 → 10 Hz)
; pot1 = profundidad   (0 → nada · 1 → ±1,2 ms)
; pot2 = mezcla        (1 → vibrato puro · 0,5 → chorus)

equ  e     60                 ; excursión: ±1,2 ms

equ  kwet     reg0
equ  kdry     reg1
equ  tmp      reg2
equ  yw       reg3

mem  vb    2*e + 4

lfo  0  sin  e

; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
        sof   0, 1/512
        wrax  tmp, 0
inicio:
; ── controles ────────────────────────────────────────────────────────
include  comun/mezcla.sasm
        rdax  pot0, 512*2*8/48828.125
        sof   1.0, 512*2*2/48828.125
        mulx  tmp
        wrax  lfo0_rate, 0
        rdax  pot1, 1.0
        wrax  lfo0_depth, 0
; ── vibrato ──────────────────────────────────────────────────────────
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        wra   vb, 0
        cho   vb + 1, 1.0, lfo0
        mulx  kwet
        wrax  yw, 0
; ── salida ───────────────────────────────────────────────────────────
        rdax  adcl, 1.0
        mulx  kdry
        rdax  yw, 1.0
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  yw, 1.0
        wrax  dacr, 0
