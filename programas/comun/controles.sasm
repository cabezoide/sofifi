;
; comun/controles.sasm — decay, damping y mezcla desde pot0, pot1 y pot2.
; Necesita los registros kdecay, kdamp, kwet y kdry.
;
; pot0 = decay    (kdecay: 0 → 0,25 · 1 → 0,95)
; pot1 = damping  (kdamp:  0 → 1, brillante · 1 → 0,3, oscuro)
; pot2 = mezcla   (0 → seco · 1 → solo efecto)

        rdax  pot0, 0.7
        sof   1.0, 0.25
        wrax  kdecay, 0
        rdax  pot1, -0.7
        sof   1.0, 0.999
        wrax  kdamp, 0
        rdax  pot2, 1.0
        wrax  kwet, -1.0
        sof   1.0, 0.999
        wrax  kdry, 0
