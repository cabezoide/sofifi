; SPDX-License-Identifier: MIT
;
; familia: delay
; resumen: Eco de tambor magnético de cuatro cabezas: un ritmo que sale de las cabezas encendidas.
; resumen.en: A four-head magnetic drum echo: a rhythm that comes from the heads that are on.
; resumen.zh-CN: 四磁头磁鼓回声：节奏来自打开的磁头组合。
; resumen.ja: 4 ヘッドの磁気ドラム・エコー。オンにしたヘッドの組み合わせがリズムになります。
;
; tambor.sasm — Eco de tambor magnético con cuatro cabezas de lectura. Un tambor
; gira y la cabeza de grabación escribe en él. Las cuatro cabezas leen a 1/4,
; 2/4, 3/4 y 4/4 de la vuelta P. Cada combinación de cabezas da un patrón
; rítmico distinto.
;
; Cada muestra:
;   1. Lee las cuatro cabezas con cuatro LFO senoidales parados (ver
;      comun/tiempo.sasm). La cabeza k tiene base k·b1 y excursión k·e1. Con la
;      misma depth en los cuatro LFO, la cabeza k lee a k·P/4 exactamente.
;   2. pot3 elige por zonas una de diez combinaciones de cabezas.
;   3. La realimentación es la suma de las cabezas elegidas dividida por su
;      número. Así, más cabezas no dan más ganancia en el bucle y el eco no se
;      desboca.
;   4. Edad: un paso bajo en el bucle y un temblor lento y aleatorio de la
;      velocidad (comun/azar_lento.sasm). El CLIP limita lo que se graba.
;   5. Con el footswitch, el tambor queda congelado: la cabeza 4 se graba otra
;      vez sobre sí misma y la entrada no entra.
;
; Combinaciones de pot3 (diez zonas iguales): 1 · 2 · 3 · 4 · 1+3 · 2+4 ·
; 3+4 · 1+2+3 · 1+2+4 · 1+2+3+4.
;
; Diseño propio, a partir del principio de los ecos de tambor de varias
; cabezas (pedal Hydra de PedalPCB): las cabezas están repartidas por igual
; en la vuelta y un interruptor enciende cada una.
;
; pot0 = velocidad        (0 → vuelta de 0,77 s · 1 → vuelta de 0,1 s)
; pot1 = realimentación   (0 → una vuelta · 1 → 0,97)
; pot2 = mezcla           (0 → seco · 1 → solo ecos)
; pot3 = cabezas          (diez combinaciones, de «solo la 1» a «las cuatro»)
; pot4 = edad             (0 → tambor nuevo · 1 → oscuro y con temblor)
; pot5 = tono             (0 → oscuro · 1 → limpio)
; sw   = congela el tambor mientras se pisa (paso 5)

equ  b1    1221               ; cuarto de la vuelta mínima (0,1 s / 4)
equ  e1    4096               ; excursión de la cabeza 1; la 4 tiene 16 384
equ  kwow  0.004              ; temblor máximo de la depth con edad = 1

equ  kwet      reg0
equ  kdry      reg1
equ  tmp       reg2
equ  tiempo    reg3
equ  c1        reg4
equ  c2        reg5
equ  c3        reg6
equ  c4        reg7
equ  fbn       reg8
equ  wo        reg9
equ  lp        reg10
equ  tn        reg11
equ  klp       reg12
equ  ktono     reg13
equ  wv        reg14
equ  xlog      reg15
equ  cuenta_az reg16
equ  azar      reg17

mem  cab   4*b1 + 8*e1 + 3

lfo  0  sin  e1
lfo  1  sin  2*e1
lfo  2  sin  3*e1
lfo  3  sin  4*e1

; ── los cuatro LFO del tiempo quedan parados (rate 0) ─────────────────
        wrax  lfo0_rate, 0              ; ACC vale 0 al empezar la muestra
        wrax  lfo1_rate, 0
        wrax  lfo2_rate, 0
        wrax  lfo3_rate, 0
; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
        sof   0, 0.5                    ; un cuarto de vuelta: la forma vale 1
        wrax  lfo0_rate, 1.0
        wrax  lfo1_rate, 1.0
        wrax  lfo2_rate, 1.0
        wrax  lfo3_rate, 0
inicio:
; ── controles ────────────────────────────────────────────────────────
include  comun/mezcla.sasm
include  comun/azar_lento.sasm
        rdax  pot4, -0.75               ; klp: 0,95 (nuevo) → 0,2 (viejo)
        sof   1.0, 0.95
        wrax  klp, 0
        rdax  pot5, 0.8                 ; ktono: 0,15 → 0,95
        sof   1.0, 0.15
        wrax  ktono, 0
        rdax  azar, 1.0                 ; temblor = kwow·edad·(azar − 0,5)
        sof   1.0, -0.5
        mulx  pot4
        sof   kwow, 0.999               ; objetivo = 1 − 2·pot0 + temblor
        rdax  pot0, -1.999
        rdfx  tiempo, 0.0005            ; deslizamiento de ~40 ms
        wrax  tiempo, 1.0
        wrax  lfo0_depth, 1.0
        wrax  lfo1_depth, 1.0
        wrax  lfo2_depth, 1.0
        wrax  lfo3_depth, 0
; ── 1. las cuatro cabezas ────────────────────────────────────────────
        cho   cab + b1, 1.0, lfo0
        wrax  c1, 0
        cho   cab + 2*b1, 1.0, lfo1
        wrax  c2, 0
        cho   cab + 3*b1, 1.0, lfo2
        wrax  c3, 0
        cho   cab + 4*b1, 1.0, lfo3
        wrax  c4, 0
; ── 2 y 3. combinación: fbn = suma/n · wo = suma·kout(n) ─────────────
        rdax  pot3, 1.0
        sof   1.0, -0.1
        skp   neg, z1
        sof   1.0, -0.1
        skp   neg, z2
        sof   1.0, -0.1
        skp   neg, z3
        sof   1.0, -0.1
        skp   neg, z4
        sof   1.0, -0.1
        skp   neg, z13
        sof   1.0, -0.1
        skp   neg, z24
        sof   1.0, -0.1
        skp   neg, z34
        sof   1.0, -0.1
        skp   neg, z123
        sof   1.0, -0.1
        skp   neg, z124
        clr                             ; 1+2+3+4: kout = 0,475
        rdax  c1, 0.25
        rdax  c2, 0.25
        rdax  c3, 0.25
        rdax  c4, 0.25
        wrax  fbn, 1.9
        wrax  wo, 0
        skp   zro, cabezas_fin
z1:
        clr
        rdax  c1, 1.0
        wrax  fbn, 1.0
        wrax  wo, 0
        skp   zro, cabezas_fin
z2:
        clr
        rdax  c2, 1.0
        wrax  fbn, 1.0
        wrax  wo, 0
        skp   zro, cabezas_fin
z3:
        clr
        rdax  c3, 1.0
        wrax  fbn, 1.0
        wrax  wo, 0
        skp   zro, cabezas_fin
z4:
        clr
        rdax  c4, 1.0
        wrax  fbn, 1.0
        wrax  wo, 0
        skp   zro, cabezas_fin
z13:
        clr                             ; dos cabezas: kout = 0,7
        rdax  c1, 0.5
        rdax  c3, 0.5
        wrax  fbn, 1.4
        wrax  wo, 0
        skp   zro, cabezas_fin
z24:
        clr
        rdax  c2, 0.5
        rdax  c4, 0.5
        wrax  fbn, 1.4
        wrax  wo, 0
        skp   zro, cabezas_fin
z34:
        clr
        rdax  c3, 0.5
        rdax  c4, 0.5
        wrax  fbn, 1.4
        wrax  wo, 0
        skp   zro, cabezas_fin
z123:
        clr                             ; tres cabezas: kout = 0,6
        rdax  c1, 1/3
        rdax  c2, 1/3
        rdax  c3, 1/3
        wrax  fbn, 1.8
        wrax  wo, 0
        skp   zro, cabezas_fin
z124:
        clr
        rdax  c1, 1/3
        rdax  c2, 1/3
        rdax  c4, 1/3
        wrax  fbn, 1.8
        wrax  wo, 0
cabezas_fin:
; ── 4. bucle: paso bajo de la edad, swell, entrada y CLIP ────────────
        clr
        rdax  fbn, 1.0                  ; lp = lp + klp·(fbn − lp)
        rdax  lp, -1.0
        mulx  klp
        rdax  lp, 1.0
        wrax  lp, 1.0
        mulx  pot1
        sof   0.97, 0
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        sof   2/3, 0                    ; curva_suave(2x/3): pendiente 1, techo ±1
        clip
; ── 5. congelación: w = w + sw·(c4 − w) ──────────────────────────────
        wrax  wv, -1.0
        rdax  c4, 1.0
        mulx  sw
        rdax  wv, 1.0
        wra   cab, 0
; ── salida: tono sobre los ecos ──────────────────────────────────────
        rdax  wo, 1.0                   ; tn = tn + ktono·(wo − tn)
        rdax  tn, -1.0
        mulx  ktono
        rdax  tn, 1.0
        wrax  tn, 1.0
        mulx  kwet
        wrax  wo, 0
        rdax  adcl, 1.0
        mulx  kdry
        rdax  wo, 1.0
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  wo, 1.0
        wrax  dacr, 0
