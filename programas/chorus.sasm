; SPDX-License-Identifier: MIT
;
; familia: modulación
; resumen: Tres voces con retardos que se mueven.
;
; chorus.sasm — Ensemble de 3 voces (hoja de ruta de la Fase 03, punto 9).
; Diseño propio.
;
; Tres lecturas de la misma memoria, cada una movida por su LFO senoidal. Las
; tres velocidades guardan la proporción 1 : 1,37 : 1,83, para que las voces no
; coincidan. La voz 1 va a la izquierda, la 3 a la derecha y la 2 a las dos.
;
; pot0 = velocidad     (0 → 0,1 Hz · 1 → 2 Hz, la voz más lenta)
; pot1 = profundidad   (0 → nada · 1 → ±2,5 ms)
; pot2 = mezcla        (0 → seco · 1 → solo voces)

equ  e     120                ; excursión de los LFO: ±2,5 ms
equ  d     977                ; retardo central: 20 ms

equ  kwet     reg0
equ  kdry     reg1
equ  tmp      reg2
equ  v1       reg3
equ  v2       reg4
equ  v3       reg5
equ  tmp2     reg6

mem  cor   d + e + 3

lfo  0  sin  e
lfo  1  sin  e
lfo  2  sin  e

; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
        sof   0, 1/512                  ; tmp = 2^-9 para fijar frecuencias finas
        wrax  tmp, 0
inicio:
; ── controles ────────────────────────────────────────────────────────
include  comun/mezcla.sasm
        rdax  pot0, 512*2*1.9/48828.125 ; rate = 2f/fs, f de 0,1 a 2 Hz
        sof   1.0, 512*2*0.1/48828.125
        mulx  tmp
        wrax  lfo0_rate, 1.37
        wrax  lfo1_rate, 1.83/1.37
        wrax  lfo2_rate, 0
        rdax  pot1, 1.0
        wrax  lfo0_depth, 1.0
        wrax  lfo1_depth, 1.0
        wrax  lfo2_depth, 0
; ── voces ────────────────────────────────────────────────────────────
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        wra   cor, 0
        cho   cor + d - e, 1.0, lfo0
        wrax  v1, 0
        cho   cor + d - e, 1.0, lfo1
        wrax  v2, 0
        cho   cor + d - e, 1.0, lfo2
        wrax  v3, 0
; ── salida ───────────────────────────────────────────────────────────
        rdax  v1, 1.0
        rdax  v2, 0.5
        mulx  kwet
        wrax  tmp2, 0
        rdax  adcl, 1.0
        mulx  kdry
        rdax  tmp2, 1.0
        wrax  dacl, 0
        rdax  v3, 1.0
        rdax  v2, 0.5
        mulx  kwet
        wrax  tmp2, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  tmp2, 1.0
        wrax  dacr, 0
