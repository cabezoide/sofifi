; SPDX-License-Identifier: MIT
;
; familia: reverb
; resumen: Plate que se satura después de la cola: un muro de ruido cálido detrás de la guitarra.
; resumen.en: A plate that saturates after the tail: a wall of warm noise behind the guitar.
; resumen.zh-CN: 尾音之后再过载的 plate：吉他身后一堵温暖的噪声之墙。
; resumen.ja: 残響の後で歪む plate：ギターの後ろに温かいノイズの壁。
;
; shoegaze.sasm — Plate de Dattorro (ver plate.sasm) con una saturación sobre la
; cola. La señal seca queda limpia. Como en saturacion.sasm, la ganancia es
; x + 15·pot3·x y CLIP la recorta suave; un paso bajo fijo (unos 2,3 kHz)
; quita la aspereza. La mezcla escala la cola después de saturarla: así el
; mando cambia el volumen y no la cantidad de saturación. La salida baja de
; 0,6 a 0,1 cuando sube pot3, para que el volumen no salte (SECURITY.md). Idea de la reverb
; saturada de los multiefectos (docs/investigacion/INVESTIGACION.md §1.1).
; Diseño propio.
;
; pot0 = decay · pot1 = damping · pot2 = mezcla (como plate.sasm)
; pot3 = saturación  (0 → limpio · 1 → ganancia ×16)

include  comun/dattorro_decl.sasm

equ  x        reg9
equ  px       reg10
equ  satl     reg11
equ  satr     reg12
equ  kwets    reg13
equ  kdrys    reg14
equ  kout     reg15

; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
include  comun/dattorro_lfo.sasm
        sof   0, 0.99
        wrax  lfo0_depth, 1.0
        wrax  lfo1_depth, 0
inicio:
include  comun/controles.sasm
; la mezcla se aplica al final; el plate trabaja con toda la entrada y sin seco
        rdax  kwet, 1.0
        wrax  kwets, 0
        rdax  kdry, 1.0
        wrax  kdrys, 0
        wrax  kdry, 0
        sof   0, 0.99997
        wrax  kwet, 0
        rdax  pot3, -0.5                ; kout de 0,6 a 0,1: el volumen no salta con la saturación
        sof   1.0, 0.6
        wrax  kout, 0
; ── plate ────────────────────────────────────────────────────────────
include  comun/entrada.sasm
        rdfx  bw, kbw
        wrax  bw, 1.0
include  comun/dattorro_difusion.sasm
include  comun/dattorro_tanque.sasm
include  comun/dattorro_salida.sasm
; ── saturación de la cola izquierda ──────────────────────────────────
        rdax  dacl, 1.0
        wrax  x, 1.0
        mulx  pot3
        wrax  px, 0
        rdax  x, 1.0
        rdax  px, 1.875
        rdax  px, 1.875
        rdax  px, 1.875
        rdax  px, 1.875
        rdax  px, 1.875
        rdax  px, 1.875
        rdax  px, 1.875
        rdax  px, 1.875
        clip
        rdfx  satl, 0.3
        wrax  satl, 1.0
        mulx  kout
        mulx  kwets
        wrax  dacl, 0
        rdax  adcl, 1.0
        mulx  kdrys
        rdax  dacl, 1.0
        wrax  dacl, 0
; ── saturación de la cola derecha ────────────────────────────────────
        rdax  dacr, 1.0
        wrax  x, 1.0
        mulx  pot3
        wrax  px, 0
        rdax  x, 1.0
        rdax  px, 1.875
        rdax  px, 1.875
        rdax  px, 1.875
        rdax  px, 1.875
        rdax  px, 1.875
        rdax  px, 1.875
        rdax  px, 1.875
        rdax  px, 1.875
        clip
        rdfx  satr, 0.3
        wrax  satr, 1.0
        mulx  kout
        mulx  kwets
        wrax  dacr, 0
        rdax  adcr, 1.0
        mulx  kdrys
        rdax  dacr, 1.0
        wrax  dacr, 0
