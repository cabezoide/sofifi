; SPDX-License-Identifier: MIT
;
; familia: modulación
; resumen: Retardo muy corto y móvil con realimentación: peines que barren.
;
; flanger.sasm — Flanger con realimentación. Diseño propio.
;
; Un retardo muy corto (de 0,04 a 5 ms) se mueve con un LFO senoidal. Al sumarlo
; a la señal seca, los filtros en peine suben y bajan. La realimentación hace
; los peines más marcados.
;
; pot0 = velocidad        (0 → 0,05 Hz · 1 → 2 Hz)
; pot1 = profundidad      (0 → retardo fijo · 1 → barrido completo)
; pot2 = mezcla           (0,5 → peines más profundos)
; pot3 = realimentación   (0 → nada · 1 → 0,9)

equ  e     120                ; excursión: el retardo va de 2 a 2 + 2·e muestras

equ  kwet     reg0
equ  kdry     reg1
equ  tmp      reg2
equ  y        reg3
equ  yw       reg4

mem  fl    2*e + 6

lfo  0  sin  e

; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
        sof   0, 1/512
        wrax  tmp, 0
inicio:
; ── controles ────────────────────────────────────────────────────────
include  comun/mezcla.sasm
        rdax  pot0, 512*2*1.95/48828.125
        sof   1.0, 512*2*0.05/48828.125
        mulx  tmp
        wrax  lfo0_rate, 0
        rdax  pot1, 1.0
        wrax  lfo0_depth, 0
; ── retardo con realimentación ───────────────────────────────────────
        cho   fl + 2, 1.0, lfo0
        wrax  y, 1.0
        mulx  pot3
        sof   0.9, 0
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        wra   fl, 0
; ── salida ───────────────────────────────────────────────────────────
        rdax  y, 1.0
        mulx  kwet
        wrax  yw, 0
        rdax  adcl, 1.0
        mulx  kdry
        rdax  yw, 1.0
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  yw, 1.0
        wrax  dacr, 0
