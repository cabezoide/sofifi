; SPDX-License-Identifier: MIT
;
; shimmer.sasm — Plate de Dattorro (ver plate.sasm) con un pitch shifter de +12
; semitonos de doble tap (CHO con rampa y ventanas complementarias) en la
; realimentación: cada vuelta sube una octava y los filtros la amansan.
; Idea de Eno y Lanois; arquitectura tipo Eventide/BigSky (docs/investigacion).
;
; pot0 = decay · pot1 = damping · pot2 = mezcla · pot3 = cantidad de shimmer

include  comun/dattorro_decl.sasm

equ  kshim    reg9
equ  shlp     reg10
equ  shhp     reg11
equ  shout    reg12

mem  pit   4096 + 3               ; buffer del pitch shifter

lfo  2  ramp 4096                 ; ventana del pitch shifter

; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
include  comun/dattorro_lfo.sasm
        sof   0, 0.99
        wrax  lfo0_depth, 1.0
        wrax  lfo1_depth, 0
        sof   0, -1/2048                ; rate = -2^24/4096: el retardo baja 1 muestra por muestra → +12
        wrax  lfo2_rate, 0
inicio:
include  comun/controles.sasm
        rdax  pot3, 0.6
        wrax  kshim, 0
; ── entrada: mono, escalada por la mezcla, predelay y ancho de banda ─
include  comun/entrada.sasm
        rdfx  bw, kbw
        wrax  bw, 1.0
        rdax  shout, 1.0                ; realimentación del shimmer
include  comun/dattorro_difusion.sasm
; ── tanque, rama izquierda ───────────────────────────────────────────
        rda   dr2#, 1.0
        mulx  kdecay
        rdax  entrada, 1.0
        cho   tl1 + 672*s - ex, -kdd1, lfo0
        wrap  tl1, kdd1
        wra   dl1, 0
        rda   dl1#, 1.0
        rdax  lpl, -1.0
        mulx  kdamp
        rdax  lpl, 1.0
        wrax  lpl, 1.0
        mulx  kdecay
        sof   2/3, 0                    ; curva_suave(2x/3): pendiente 1, techo ±1
        clip
        rda   tl2#, kdd2
        wrap  tl2, -kdd2
        wra   dl2, 0
; ── tanque, rama derecha ─────────────────────────────────────────────
        rda   dl2#, 1.0
        mulx  kdecay
        rdax  entrada, 1.0
        cho   tr1 + 908*s - ex, -kdd1, lfo1
        wrap  tr1, kdd1
        wra   dr1, 0
        rda   dr1#, 1.0
        rdax  lpr, -1.0
        mulx  kdamp
        rdax  lpr, 1.0
        wrax  lpr, 1.0
        mulx  kdecay
        sof   2/3, 0
        clip
        rda   tr2#, kdd2
        wrap  tr2, -kdd2
        wra   dr2, 0
include  comun/dattorro_salida.sasm
; ── shimmer: +12 de doble tap sobre la cola izquierda, filtrado, de vuelta a la entrada ──
        rda   dr1 + 266*s, ksal
        rda   dr1 + 2974*s, ksal
        rda   dl1 + 1990*s, -ksal
        wra   pit, 0
        cho   pit + 1, 1.0, lfo2, na
        cho   pit + 1, 1.0, lfo2, na|media
        rdfx  shlp, 0.35                ; paso bajo: quita el brillo áspero de cada vuelta
        wrax  shlp, 1.0
        rdfx  shhp, 0.02                ; paso alto = x − paso bajo lento
        wrax  shhp, -1.0
        rdax  shlp, 1.0
        mulx  kshim
        wrax  shout, 0
