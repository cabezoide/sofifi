; SPDX-License-Identifier: MIT
;
; familia: delay
; resumen: Eco que se aparta mientras se toca y aparece en los silencios.
;
; ducking.sasm — El delay de delay.sasm con la salida de ecos controlada por la
; entrada: un seguidor de picos (MAXX) baja los ecos mientras suena la guitarra.
; Al callar, los ecos vuelven en unos 0,3 s. Hoja de ruta de la Fase 03, punto 4.
;
; pot0 = tiempo           (0 → 20 ms · 1 → 690 ms)
; pot1 = realimentación   (0 → un eco · 1 → 0,95)
; pot2 = mezcla           (0 → seco · 1 → solo ecos)
; pot3 = ducking          (0 → nada · 1 → los ecos bajan un 90 %)

equ  et    16384
equ  base  977

equ  trate    lfo0_rate
equ  tdepth   lfo0_depth
equ  tpot     pot0
equ  kwet     reg0
equ  kdry     reg1
equ  tiempo   reg2
equ  ktono    reg3
equ  lp       reg4
equ  eco      reg5
equ  ecow     reg6
equ  mono     reg7
equ  env      reg8
equ  gan      reg9

mem  dl    base + 2*et + 3

lfo  0  sin  et

        wrax  trate, 0                  ; ACC vale 0 al empezar la muestra
        skp   run, inicio
        sof   0, 0.5                    ; un cuarto de vuelta: forma 1
        wrax  trate, 0
inicio:
include  comun/mezcla.sasm
include  comun/tiempo.sasm
        sof   0, 0.6                    ; tono fijo del eco
        wrax  ktono, 0
; ── seguidor de picos: env = max(|x|, 0,99986·env), ~0,15 s de caída ─
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        wrax  mono, 0
        rdax  env, 0.99986
        maxx  mono, 1.0
        wrax  env, 0
; ── gan = 1 − pot3·min(1, 4·env), suavizada ─────────────────────────
        rdax  env, 1.999                ; ACC = 4·env (ancho: aún no satura)
        rdax  env, 1.999
        sof   1.0, 0                    ; a24 satura: min(1, 4·env)
        mulx  pot3
        sof   -0.9, 0.99997
        rdfx  gan, 0.002
        wrax  gan, 0
; ── eco ──────────────────────────────────────────────────────────────
        cho   dl + base, 1.0, lfo0
        rdax  lp, -1.0                  ; lp = lp + ktono·(x − lp)
        mulx  ktono
        rdax  lp, 1.0
        wrax  lp, 1.0
        wrax  eco, 1.0
        mulx  pot1
        sof   0.95, 0
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        wra   dl, 0
; ── salida ───────────────────────────────────────────────────────────
        rdax  eco, 1.0
        mulx  kwet
        mulx  gan
        wrax  ecow, 0
        rdax  adcl, 1.0
        mulx  kdry
        rdax  ecow, 1.0
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  ecow, 1.0
        wrax  dacr, 0
