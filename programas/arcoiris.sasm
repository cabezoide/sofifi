; SPDX-License-Identifier: MIT
;
; familia: pitch
; resumen: Dos voces transpuestas en un bucle que regenera y llega a autooscilar.
; resumen.en: Two pitch-shifted voices in a loop that regenerates and can self-oscillate.
; resumen.zh-CN: 两个移调声部置于再生回路中，可受控自激振荡。
; resumen.ja: 再生ループ内の 2 つの移調声部。制御された自己発振が可能。
;
; arcoiris.sasm — La entrada y la realimentación entran en una memoria común.
; Dos pitch shifters de doble tap leen esa memoria. La voz A tiene un intervalo
; continuo. La voz B está una octava abajo o arriba. Un retardo corto atrasa
; las dos voces respecto a la señal seca. Después hay un paso bajo de tono, un
; paso alto fijo (unos 75 Hz) y un CLIP. La salida del CLIP vuelve a la entrada
; multiplicada por la regeneración. Con una regeneración mayor que 1, el bucle
; autooscila. Cada vuelta mueve otra vez el tono: la estela sube o baja. El CLIP
; limita el pico y los filtros sacan la energía por los extremos del espectro.
;
; El intervalo de A sale de un polinomio cúbico en pot0. El polinomio aproxima
; la razón 2^(2·pot0 − 1) con un error de menos de 8 cents.
;
; pot0 = intervalo        (0 → −12 · 0,5 → unísono · 1 → +12 semitonos, continuo)
; pot1 = segunda voz      (0 → −12 a nivel 1 · 0,5 → sin voz B · 1 → +12 a nivel 1)
; pot2 = mezcla           (0 → seco · 1 → solo las voces)
; pot3 = tiempo           (retraso de las voces: 1 ms a 170 ms)
; pot4 = realimentación   (regeneración: 0 → una pasada · 1 → 1,1, autooscila)
; pot5 = tono             (0 → oscuro · 1 → brillante)
; sw   = regeneración al máximo (1,1) mientras se pisa
;
; Diseño propio, a partir del principio de los armonizadores de dos voces con
; regeneración: una voz de intervalo libre, otra a una octava, un retraso de
; las voces y una realimentación que hace chocar las dos.

equ  w     4096
equ  et    4096
equ  base  49

equ  trate    lfo2_rate
equ  tdepth   lfo2_depth
equ  tpot     pot3
equ  kwet     reg0
equ  kdry     reg1
equ  tmp      reg2
equ  kb       reg3
equ  fb       reg4
equ  voces    reg5
equ  lp       reg6
equ  bajo     reg7
equ  sal      reg8
equ  salw     reg9
equ  tiempo   reg10
equ  ktono    reg11
equ  kmag     reg12

mem  pa    w + 3
mem  dl    base + 2*et + 3

lfo  0  ramp w
lfo  1  ramp w
lfo  2  sin  et

        wrax  trate, 0                  ; ACC vale 0 al empezar la muestra
; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
        sof   0, 1/512                  ; tmp = 2^-9
        wrax  tmp, 0
        sof   0, 0.5                    ; un cuarto de vuelta: forma 1
        wrax  trate, 0
inicio:
; ── controles ────────────────────────────────────────────────────────
include  comun/mezcla.sasm
include  comun/tiempo.sasm
        ; voz A: rate = g(pot0)·tmp, con g(p) ≈ (1 − 2^(2p − 1))/4
        sof   0, -0.11403
        mulx  pot0
        sof   1.0, -0.07761
        mulx  pot0
        sof   1.0, -0.18327
        mulx  pot0
        sof   1.0, 0.12551
        mulx  tmp
        wrax  lfo0_rate, 0
        ; voz B: k = 2·pot1 − 1; k < 0 → −12 con nivel −k, k ≥ 0 → +12 con nivel k
        rdax  pot1, 1.999
        sof   1.0, -1.0
        skp   neg, b_baja
        wrax  kb, 0
        rdax  tmp, -0.25                ; +12: razón 2
        skp   gez|neg, b_fin
b_baja:
        sof   -1.0, 0
        wrax  kb, 0
        rdax  tmp, 0.125                ; −12: razón 0,5
b_fin:
        wrax  lfo1_rate, 0
        ; regeneración: max(pot4, sw); el 1,1 va al sumar fb (un dato no pasa de 1)
        rdax  pot4, 1.0
        maxx  sw, 1.0
        wrax  kmag, 0
        rdax  pot5, 0.9
        sof   1.0, 0.05
        wrax  ktono, 0
; ── voces ────────────────────────────────────────────────────────────
        rdax  fb, 1.1
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        wra   pa, 0
        cho   pa + 1, 1.0, lfo0, na
        cho   pa + 1, 1.0, lfo0, na|media
        wrax  voces, 0
        cho   pa + 1, 1.0, lfo1, na
        cho   pa + 1, 1.0, lfo1, na|media
        mulx  kb
        rdax  voces, 1.0
        wra   dl, 0
; ── retraso, tono, paso alto y límite ────────────────────────────────
        cho   dl + base, 1.0, lfo2
        rdax  lp, -1.0                  ; lp = lp + ktono·(x − lp)
        mulx  ktono
        rdax  lp, 1.0
        wrax  lp, 1.0
        rdfx  bajo, 0.01                ; bajo sigue a lp por debajo de ~75 Hz
        wrax  bajo, -1.0
        rdax  lp, 1.0                   ; lp − bajo: paso alto
        sof   0.667, 0                  ; CLIP tiene pendiente 1,5 en el origen
        clip
        wrax  sal, 1.0
        mulx  kmag
        wrax  fb, 0
; ── salida ───────────────────────────────────────────────────────────
        rdax  sal, 1.0
        mulx  kwet
        wrax  salw, 0
        rdax  adcl, 1.0
        mulx  kdry
        rdax  salw, 1.0
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  salw, 1.0
        wrax  dacr, 0
