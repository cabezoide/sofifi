; SPDX-License-Identifier: MIT
;
; familia: reverb
; resumen: Plate de Dattorro con el tanque modulado.
;
; plate.sasm — Plate de Dattorro (J. Dattorro, "Effect Design Part 1", JAES 1997),
; reescrito para el núcleo SOFIFI a partir del paper (ver docs/terceros.yaml T-003).
; Longitudes del paper a 29 761 Hz, reescaladas a fs = 48 828,125 Hz (ADR 0005).
; Coeficientes y taps de salida: tabla 1 y tabla 2 del paper [verificar contra el PDF].
; Los bloques comunes con shimmer y freeze están en comun/.
;
; pot0 = decay    (0 → 0,25 · 1 → 0,95)
; pot1 = damping  (0 → brillante · 1 → oscuro)
; pot2 = mezcla   (0 → seco · 1 → solo reverb)

include  comun/dattorro_decl.sasm

; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
include  comun/dattorro_lfo.sasm
        sof   0, 0.99
        wrax  lfo0_depth, 1.0
        wrax  lfo1_depth, 0
inicio:
include  comun/controles.sasm
; ── entrada: mono, escalada por la mezcla, predelay y ancho de banda ─
include  comun/entrada.sasm
        rdfx  bw, kbw
        wrax  bw, 1.0
include  comun/dattorro_difusion.sasm
include  comun/dattorro_tanque.sasm
include  comun/dattorro_salida.sasm
