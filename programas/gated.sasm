; SPDX-License-Identifier: MIT
;
; familia: reverb
; resumen: Reverb que se corta de golpe tras cada ataque, como en los años 80.
;
; gated.sasm — Plate denso con una compuerta en la salida. Cada ataque abre la
; compuerta (comun/compuerta.sasm); se cierra cuando pasa el tiempo de pot3,
; aunque la cola siga sonando. Idea de las reverbs «gated» y «nonlinear»
; (docs/investigacion/INVESTIGACION.md §4.3). Diseño propio.
;
; pot0 = decay · pot1 = damping · pot2 = mezcla (como plate.sasm)
; pot3 = duración  (0 → 50 ms · 0,5 → 150 ms · 1 → 500 ms)

include  comun/dattorro_decl.sasm

equ  envr     reg9
equ  envl     reg10
equ  cuenta   reg11
equ  tmin     0.05             ; duración con pot3 = 0 (s)
equ  tmax     0.5             ; duración con pot3 = 1 (s)
equ  kpaso    reg12
equ  gan      reg13
equ  kdrys    reg14

; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
include  comun/dattorro_lfo.sasm
        sof   0, 0.99
        wrax  lfo0_depth, 1.0
        wrax  lfo1_depth, 0
inicio:
include  comun/controles.sasm
include  comun/duracion.sasm
; ── compuerta: abierta (1) mientras cuenta > 0 ───────────────────────
include  comun/compuerta.sasm
        skp   neg, cerrada
        sof   0, 0.99997
        skp   gez, ganancia
cerrada:
        clr
ganancia:
        rdfx  gan, 0.05                 ; sin clics: unos 0,4 ms de rampa
        wrax  gan, 0
; ── plate: la salida sale sin señal seca y después se multiplica ─────
        rdax  kdry, 1.0
        wrax  kdrys, 0
        wrax  kdry, 0
include  comun/entrada.sasm
        rdfx  bw, kbw
        wrax  bw, 1.0
include  comun/dattorro_difusion.sasm
include  comun/dattorro_tanque.sasm
include  comun/dattorro_salida.sasm
include  comun/salida_con_ganancia.sasm
