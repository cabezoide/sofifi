; SPDX-License-Identifier: MIT
;
; familia: reverb
; resumen: Shimmer que se regula solo: cuanta más octava acumula, menos añade.
;
; shimmer_energia.sasm — El shimmer de +12 (shimmer.sasm) con criterio energético
; (hoja de ruta de la Fase 03, punto 7). Un seguidor de picos (MAXX) mide la
; señal que vuelve del pitch shifter. Cuanto más alta, menos shimmer entra:
; kshim·(1 − min(1, 3·env)). Con notas largas, la octava no se acumula hasta
; saturar; con notas sueltas, suena como el shimmer. Diseño propio.
;
; pot0 = decay · pot1 = damping · pot2 = mezcla · pot3 = cantidad de shimmer

equ  rate_pit  -1/2048            ; +12: razón 2
equ  envsh     reg13
equ  tmpsh     reg14

include  comun/shimmer_cuerpo.sasm
; ── criterio energético: kshim·(1 − min(1, 3·env)) ───────────────────
        rdax  envsh, 0.9995
        maxx  shout, 1.0
        wrax  envsh, 0
        rdax  envsh, 1.5
        rdax  envsh, 1.5                ; 3·env en el ACC ancho
        sof   1.0, 0                    ; a24 satura: min(1, 3·env)
        sof   -1.0, 0.99997
        mulx  kshim
        wrax  kshim, 0
include  comun/shimmer_cola.sasm
