; SPDX-License-Identifier: MIT
;
; familia: reverb
; resumen: Red de 8 retardos con matriz de Householder: sala grande.
;
; hall.sasm — Hall de red de retardo con realimentación (FDN) de 8 líneas.
; Diseño propio a partir de la literatura: J.-M. Jot y A. Chaigne, «Digital
; delay networks for designing artificial reverberators», AES 1991 [?]. No
; porta código de terceros.
;
; Cada muestra:
;   1. Lee el final de las 8 líneas y lo pasa por un paso bajo (damping): x_i.
;   2. Mezcla con la matriz de Householder: y_i = x_i − (2/8)·Σx. La matriz es
;      ortogonal: no gana ni pierde energía, así que el decay lo fija kdecay.
;   3. Escribe kdecay·y_i + entrada en el inicio de cada línea.
; Las líneas miden entre 55 y 103 ms, con longitudes primas entre sí. Dos de
; ellas están moduladas (LFO senoidal) para que la cola no suene metálica.
;
; pot0 = decay    (kdecay 0,25 → T60 ≈ 0,5 s · 0,95 → T60 ≈ 8 s) [INF]
; pot1 = damping  (0 → brillante · 1 → oscuro)
; pot2 = mezcla   (0 → seco · 1 → solo reverb)

equ  ex    12                 ; excursión de la modulación, en muestras
equ  kap   0.65               ; difusión de entrada
equ  kin   0.7                ; ganancia de la entrada en cada línea
equ  ksal  0.7                ; ganancia de cada línea en la salida

equ  kdecay   reg0
equ  kdamp    reg1
equ  kwet     reg2
equ  kdry     reg3
equ  tmp      reg4
equ  entrada  reg5
equ  suma     reg6
equ  x0       reg8
equ  x1       reg9
equ  x2       reg10
equ  x3       reg11
equ  x4       reg12
equ  x5       reg13
equ  x6       reg14
equ  x7       reg15

mem  pre   1465               ; predelay de 30 ms
mem  ai1   223
mem  ai2   337
mem  ai3   557
mem  ai4   773
mem  d0    2687 + ex + 3      ; modulada: lee de 2687 − ex a 2687 + ex
mem  d1    3089
mem  d2    3413
mem  d3    3739
mem  d4    4049 + ex + 3      ; modulada
mem  d5    4363
mem  d6    4733
mem  d7    5051

lfo  0  sin  ex
lfo  1  sin  ex

; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
        sof   0, 1/512                  ; tmp = 2^-9 para fijar frecuencias finas
        wrax  tmp, 0
        rdax  tmp, 1024*0.53/48828.125  ; LFO0 a 0,53 Hz (rate = 2f/fs)
        wrax  lfo0_rate, 0
        rdax  tmp, 1024*0.71/48828.125  ; LFO1 a 0,71 Hz
        wrax  lfo1_rate, 0
        sof   0, 0.99
        wrax  lfo0_depth, 1.0
        wrax  lfo1_depth, 0
inicio:
include  comun/controles.sasm
; ── entrada y difusión ───────────────────────────────────────────────
include  comun/entrada.sasm
        rda   ai1#, kap
        wrap  ai1, -kap
        rda   ai2#, kap
        wrap  ai2, -kap
        rda   ai3#, kap
        wrap  ai3, -kap
        rda   ai4#, kap
        wrap  ai4, -kap
        wrax  entrada, 0
; ── 1. final de cada línea con damping: x = x + kdamp·(final − x) ────
        cho   d0 + 2687 - ex, 1.0, lfo0
        rdax  x0, -1.0
        mulx  kdamp
        rdax  x0, 1.0
        wrax  x0, 0
        rda   d1#, 1.0
        rdax  x1, -1.0
        mulx  kdamp
        rdax  x1, 1.0
        wrax  x1, 0
        rda   d2#, 1.0
        rdax  x2, -1.0
        mulx  kdamp
        rdax  x2, 1.0
        wrax  x2, 0
        rda   d3#, 1.0
        rdax  x3, -1.0
        mulx  kdamp
        rdax  x3, 1.0
        wrax  x3, 0
        cho   d4 + 4049 - ex, 1.0, lfo1
        rdax  x4, -1.0
        mulx  kdamp
        rdax  x4, 1.0
        wrax  x4, 0
        rda   d5#, 1.0
        rdax  x5, -1.0
        mulx  kdamp
        rdax  x5, 1.0
        wrax  x5, 0
        rda   d6#, 1.0
        rdax  x6, -1.0
        mulx  kdamp
        rdax  x6, 1.0
        wrax  x6, 0
        rda   d7#, 1.0
        rdax  x7, -1.0
        mulx  kdamp
        rdax  x7, 1.0
        wrax  x7, 0
; ── 2. Householder: suma = −(2/8)·Σx ─────────────────────────────────
        rdax  x0, -0.25
        rdax  x1, -0.25
        rdax  x2, -0.25
        rdax  x3, -0.25
        rdax  x4, -0.25
        rdax  x5, -0.25
        rdax  x6, -0.25
        rdax  x7, -0.25
        wrax  suma, 0
; ── 3. inicio de cada línea: kdecay·(x + suma) ± entrada ─────────────
        rdax  suma, 1.0
        rdax  x0, 1.0
        mulx  kdecay
        rdax  entrada, kin
        wra   d0, 0
        rdax  suma, 1.0
        rdax  x1, 1.0
        mulx  kdecay
        rdax  entrada, -kin
        wra   d1, 0
        rdax  suma, 1.0
        rdax  x2, 1.0
        mulx  kdecay
        rdax  entrada, kin
        wra   d2, 0
        rdax  suma, 1.0
        rdax  x3, 1.0
        mulx  kdecay
        rdax  entrada, -kin
        wra   d3, 0
        rdax  suma, 1.0
        rdax  x4, 1.0
        mulx  kdecay
        rdax  entrada, kin
        wra   d4, 0
        rdax  suma, 1.0
        rdax  x5, 1.0
        mulx  kdecay
        rdax  entrada, -kin
        wra   d5, 0
        rdax  suma, 1.0
        rdax  x6, 1.0
        mulx  kdecay
        rdax  entrada, kin
        wra   d6, 0
        rdax  suma, 1.0
        rdax  x7, 1.0
        mulx  kdecay
        rdax  entrada, -kin
        wra   d7, 0
; ── salida: cuatro líneas por lado, con signos alternos ──────────────
        rdax  adcl, 1.0
        mulx  kdry
        rdax  x0, ksal
        rdax  x2, -ksal
        rdax  x4, ksal
        rdax  x6, -ksal
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  x1, ksal
        rdax  x3, -ksal
        rdax  x5, ksal
        rdax  x7, -ksal
        wrax  dacr, 0
