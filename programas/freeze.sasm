; SPDX-License-Identifier: MIT
;
; familia: reverb
; resumen: Plate que congela la cola con el pulsador; la cola sigue moviéndose.
; resumen.en: A plate that freezes the tail with the footswitch; the tail keeps moving.
; resumen.zh-CN: 用脚踏开关冻结尾音的 plate；尾音仍在动。
; resumen.ja: フットスイッチで残響を凍らせる plate。残響は動き続けます。
;
; freeze.sasm — Plate de Dattorro (ver plate.sasm) con congelación por footswitch.
; Con `sw` pulsado: decay ≈ 1, sin damping y la entrada deja de alimentar el
; tanque (freeze, no infinite). **La cola congelada sigue moviéndose**: el
; tanque compensa la pérdida de la interpolación del `cho`
; (comun/dattorro_tanque_compensado.sasm), así que ya no hace falta bajar la
; modulación a 0. Medido en el modelo: la cola pierde 0,087 dB/s con la
; modulación puesta, frente a 0,382 dB/s sin compensar. Un limitador CLIP en
; cada rama del tanque impide que el bucle crezca sin control (SECURITY.md: el
; volumen es superficie de daño).
;
; pot0 = decay · pot1 = damping · pot2 = mezcla (cuando sw está suelto)

include  comun/dattorro_decl.sasm
equ  kcmp  0.05                 ; compensación de la interpolación, medida

; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio
include  comun/dattorro_lfo.sasm
inicio:
include  comun/controles.sasm
; ── freeze: con el footswitch, decay ≈ 1, sin damping y sin entrada nueva ──
        rdax  sw, 1.0
        skp   zro, sin_freeze
        sof   0, 1.0                    ; satura a 0,99999988 al escribir
        wrax  kdecay, 0
        sof   0, 1.0
        wrax  kdamp, 0                  ; kdamp = 1: el paso bajo deja pasar todo
        wrax  kwet, 0                   ; ACC = 0: la entrada no alimenta la cola
sin_freeze:
; la modulación es la misma congelado o no: el tanque compensa su pérdida.
; La profundidad sigue a su objetivo con una rampa de ~40 ms: sin clic al congelar
        sof   0, 0.99
        wrax  tmp, 0
        rdax  tmp, 1.0
        rdfx  lfo0_depth, 0.0005
        wrax  lfo0_depth, 0
        rdax  tmp, 1.0
        rdfx  lfo1_depth, 0.0005
        wrax  lfo1_depth, 0
; ── entrada: mono, escalada por la mezcla, predelay y ancho de banda ─
include  comun/entrada.sasm
        rdfx  bw, kbw
        wrax  bw, 1.0
include  comun/dattorro_difusion.sasm
include  comun/dattorro_tanque_compensado.sasm
include  comun/dattorro_salida.sasm
