; SPDX-License-Identifier: MIT
;
; familia: delay
; resumen: Eco con un phaser dentro del lazo: cada repetición barre más y la cola gira.
; resumen.en: Echo with a phaser inside the loop: each repeat sweeps more and the tail swirls.
; resumen.zh-CN: 反馈环内带移相器的回声：每次重复扫得更深，尾音化作旋涡。
; resumen.ja: ループの中にフェイザーを入れたエコー。繰り返すごとにうねりが深まり、テールが渦を巻きます。
;
; estelar.sasm — Eco con un phaser en la realimentación.
;
; Un phaser fuera del eco barre todas las repeticiones igual. Aquí el phaser
; está dentro del lazo. Cada repetición pasa otra vez por él, en otro punto
; del barrido. Las muescas de una vuelta se suman a las de la anterior. La
; cola acaba en un remolino de muescas que se mueven.
;
; Cada muestra:
;   1. Un LFO triangular por software (comun/lfo_triangulo.sasm) avanza. CLIP
;      lo redondea hacia una senoide s. Con el footswitch pisado, no avanza.
;   2. El coeficiente de las etapas sigue a s: a = −(0,6 + 0,35·s).
;   3. El CHO lee el eco (tiempo con comun/tiempo.sasm).
;   4. La entrada del phaser es u = eco + r·(y − eco): y es la salida de la
;      muestra anterior y r da la resonancia. La ganancia de pico queda en 1.
;   5. Seis allpass de primer orden en registros, en forma directa I:
;      y = a·(x − y[n−1]) + x[n−1].
;   6. Mezcla interna: ph = eco + m·(y − eco), con m = 0,5·profundidad. Con
;      m = 0,5, el eco y la cadena de fase se suman y dan las muescas.
;   7. Un paso bajo fijo de unos 4 kHz suaviza el lazo.
;   8. El retardo recibe la entrada más la realimentación.
;
; pot0 = tiempo           (0 → 20 ms · 1 → 690 ms)
; pot1 = realimentación   (0 → un eco · 1 → 0,95)
; pot2 = mezcla           (0 → seco · 1 → solo ecos)
; pot3 = profundidad      (0 → eco limpio · 1 → muescas profundas)
; pot4 = velocidad        (0 → 0,05 Hz · 1 → 3 Hz; curva cuadrática)
; pot5 = resonancia       (0 → nada · 1 → 0,7)
; sw   = mientras se pisa, el barrido se congela
;
; Diseño propio, a partir del principio del programa «Starfield» para FV-1 de
; Madbean Pedals: un eco con un phaser en el camino de la realimentación.

equ  et    16384
equ  base  977

equ  trate    lfo0_rate
equ  tdepth   lfo0_depth
equ  tpot     pot0
equ  kwet     reg0
equ  kdry     reg1
equ  tiempo   reg2
equ  tri      reg3
equ  dir      reg4
equ  vel      reg5
equ  a        reg6
equ  x        reg7
equ  y        reg8
equ  km       reg9
equ  kr       reg10
equ  lp       reg11
equ  eco      reg12
equ  ecow     reg13
equ  kfz      reg14
equ  xp1      reg15
equ  yp1      reg16
equ  xp2      reg17
equ  yp2      reg18
equ  xp3      reg19
equ  yp3      reg20
equ  xp4      reg21
equ  yp4      reg22
equ  xp5      reg23
equ  yp5      reg24
equ  xp6      reg25
equ  yp6      reg26

mem  dl    base + 2*et + 3

lfo  0  sin  et

        wrax  trate, 0                  ; ACC vale 0 al empezar la muestra
        skp   run, inicio
        sof   0, 0.5                    ; un cuarto de vuelta: forma 1
        wrax  trate, 0
inicio:
include  comun/mezcla.sasm
include  comun/tiempo.sasm
; ── mandos del phaser ────────────────────────────────────────────────
        rdax  pot3, 0.5                 ; m = 0,5·profundidad
        wrax  km, 0
        rdax  pot5, 0.7                 ; r = 0,7·resonancia
        wrax  kr, 0
        rdax  sw, -1.0                  ; 1 − sw: 0 mientras se pisa
        sof   1.0, 0.99999
        wrax  kfz, 0
; ── vel = 4f/fs, de 0,05 a 3 Hz. Se calcula ×64 y se divide al final:
;    la constante mínima no cabe en el operando D de SOF.
        rdax  pot4, 1.0
        mulx  pot4
        sof   64*4*2.95/48828.125, 64*4*0.05/48828.125
        sof   1/64, 0
        mulx  kfz
        wrax  vel, 0
; ── coeficiente: a = −(0,6 + 0,35·s) ────────────────────────────────
include  comun/lfo_triangulo.sasm
        clip
        sof   -0.35, -0.6
        wrax  a, 0
; ── eco y entrada del phaser: u = eco + r·(y − eco) ─────────────────
        cho   dl + base, 1.0, lfo0
        wrax  eco, -1.0
        rdax  y, 1.0
        mulx  kr
        rdax  eco, 1.0
; ── etapa 1 ──────────────────────────────────────────────────────────
        wrax  x, 1.0
        rdax  yp1, -1.0
        mulx  a
        rdax  xp1, 1.0
        wrax  yp1, 0
        rdax  x, 1.0
        wrax  xp1, 0
        rdax  yp1, 1.0
; ── etapa 2 ──────────────────────────────────────────────────────────
        wrax  x, 1.0
        rdax  yp2, -1.0
        mulx  a
        rdax  xp2, 1.0
        wrax  yp2, 0
        rdax  x, 1.0
        wrax  xp2, 0
        rdax  yp2, 1.0
; ── etapa 3 ──────────────────────────────────────────────────────────
        wrax  x, 1.0
        rdax  yp3, -1.0
        mulx  a
        rdax  xp3, 1.0
        wrax  yp3, 0
        rdax  x, 1.0
        wrax  xp3, 0
        rdax  yp3, 1.0
; ── etapa 4 ──────────────────────────────────────────────────────────
        wrax  x, 1.0
        rdax  yp4, -1.0
        mulx  a
        rdax  xp4, 1.0
        wrax  yp4, 0
        rdax  x, 1.0
        wrax  xp4, 0
        rdax  yp4, 1.0
; ── etapa 5 ──────────────────────────────────────────────────────────
        wrax  x, 1.0
        rdax  yp5, -1.0
        mulx  a
        rdax  xp5, 1.0
        wrax  yp5, 0
        rdax  x, 1.0
        wrax  xp5, 0
        rdax  yp5, 1.0
; ── etapa 6 ──────────────────────────────────────────────────────────
        wrax  x, 1.0
        rdax  yp6, -1.0
        mulx  a
        rdax  xp6, 1.0
        wrax  yp6, 0
        rdax  x, 1.0
        wrax  xp6, 0
        rdax  yp6, 1.0
        wrax  y, 1.0
; ── mezcla interna: ph = eco + m·(y − eco); paso bajo de ~4 kHz ─────
        rdax  eco, -1.0
        mulx  km
        rdax  eco, 1.0
        rdfx  lp, 0.4
        wrax  lp, 1.0
; ── realimentación ───────────────────────────────────────────────────
        mulx  pot1
        sof   0.95, 0
        rdax  adcl, 0.5
        rdax  adcr, 0.5
        wra   dl, 0
; ── salida ───────────────────────────────────────────────────────────
        rdax  lp, 1.0
        mulx  kwet
        wrax  ecow, 0
        rdax  adcl, 1.0
        mulx  kdry
        rdax  ecow, 1.0
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  ecow, 1.0
        wrax  dacr, 0
