; SPDX-License-Identifier: MIT
;
; familia: textura
; resumen: Nube granular de 4 voces con ventana Hann, pitch en octavas y freeze.
; resumen.en: A 4-voice granular cloud with a Hann window, octave pitch and freeze.
; resumen.zh-CN: 4 声部颗粒云，Hann 窗、八度音高和冻结。
; resumen.ja: Hann 窓、オクターブ単位のピッチ、フリーズ付きの 4 声グラニュラー。
;
; granular.sasm — granular en la región absoluta (RDAA y WRAA, ADR 0009).
;
; 1. La entrada se escribe en la región absoluta en la cabeza `w`, que da la
;    vuelta a las 32 768 muestras. Con `sw` pulsado, el búfer se congela.
; 2. Cuatro granos leen el búfer. Cada uno empieza en `w − dmin − x·disp`,
;    con x de un generador congruencial: x ← frac(5x + c), c impar. Su
;    periodo es 2^23 (Hull y Dobell).
; 3. Ventana Hann sin tabla: sin(πg) ≈ p·(0,775 + 0,225p) con p = 4g(1 − g)
;    (error < 0,2 %); la ventana es su cuadrado. Los granos 0 y 2 van media
;    vuelta desfasados, y la ventana del 2 es 1 − w0; igual el 1 y el 3. Cada
;    pareja da v2 + w0·(v0 − v2): la ganancia es constante.
;
; La fase de cada pareja va de 0 a 0,5 (un grano entero). La entrada se
; escribe a la mitad, para que v0 − v2 no sature.
;
; pot0 = duración        (0 → 21 ms · 1 → 168 ms)
; pot1 = difusión        (0 → granos juntos · 1 → repartidos en 0,17 s)
; pot2 = intervalo       (tres zonas: < 1/3 → octava baja · de 1/3 a 2/3 → unísono
;                          · > 2/3 → octava alta)
; pot3 = mezcla          (0 → seco · 1 → solo granos)

equ  u      reg0            ; una muestra: 2^-15
equ  h      reg1            ; 0,5: con -2,0 resta 1
equ  hn     reg21           ; -0,5: con -2,0 suma 1 (+2,0 no es un coeficiente)
equ  c      reg2            ; incremento del generador (impar)
equ  x      reg3            ; número aleatorio en [0, 1)
equ  w      reg4            ; cabeza de escritura
equ  df     reg5            ; avance de fase por muestra
equ  vel    reg6            ; avance de lectura por muestra
equ  dmin   reg7            ; distancia mínima a la cabeza de escritura
equ  disp   reg8            ; difusión
equ  inicio reg9            ; dónde empieza el próximo grano
equ  suma   reg10
equ  t      reg11
equ  tv     reg12
equ  fa     reg13           ; fase de los granos 0 y 2
equ  fb     reg14           ; fase de los granos 1 y 3
equ  p0     reg15
equ  p1     reg16
equ  p2     reg17
equ  p3     reg18
equ  kwet   reg19
equ  kdry   reg20

; ── inicialización (solo la primera muestra) ─────────────────────────
        skp   run, inicio_muestra
        sof   0, 1/32768
        wrax  u, 1/256                  ; ACC = 2^-23: el bit que hace impar a c
        sof   1.0, 0.381958             ; c ≈ (√5 − 1)/2 − 0,236 + 2^-23
        wrax  c, 0
        sof   0, 0.5
        wrax  h, 0
        sof   0, -0.5
        wrax  hn, 0
        sof   0, 0.125
        wrax  fb, 0                     ; la pareja B va un cuarto de grano detrás
inicio_muestra:
; ── mandos ───────────────────────────────────────────────────────────
        rdax  pot0, -0.875
        sof   1/2048, 1/2048
        wrax  df, 0                     ; 0,5 / df = 1 024 a 8 192 muestras
        rdax  pot1, 0.25
        wrax  disp, 0
        rdax  pot3, 1.0
        wrax  kwet, -1.0
        sof   1.0, 0.999
        wrax  kdry, 0
        rdax  u, 0.5
        wrax  vel, 0                    ; ½×
        sof   0, 0.004
        wrax  dmin, 0
        rdax  pot2, 1.0
        sof   1.0, -1/3
        skp   neg, escribir
        sof   1.0, -1/3
        skp   neg, unisono
        clr
        sof   0, 0.26                   ; 2×: el grano avanza 2 muestras por cada 1
        wrax  dmin, 0                   ; de la escritura; empieza 8 192 detrás
        rdax  u, 1.0
        rdax  u, 1.0
        wrax  vel, 0
        skp   zro, escribir
unisono:
        clr
        rdax  u, 1.0
        wrax  vel, 0
; ── escritura: congelada con sw ──────────────────────────────────────
escribir:
        clr
        rdax  sw, 1.0
        skp   zro, grabar
        clr
        skp   zro, aleatorio
grabar:
        clr
        rdax  adcl, 0.25
        rdax  adcr, 0.25
        wraa  w, 0
        rdax  w, 1.0
        sof   1.0, -32767/32768
        skp   neg, avanzar_w
        clr
        wrax  w, 0                      ; w = 32 767 muestras: vuelve a 0
        skp   zro, aleatorio
avanzar_w:
        clr
        rdax  w, 1.0
        rdax  u, 1.0
        wrax  w, 0
; ── x ← frac(5x + c), exacto en 23 bit ───────────────────────────────
aleatorio:
        rdax  x, 1.25
        rdax  x, 1.25
        rdax  x, 1.25
        rdax  x, 1.25
        rdax  c, 1.0                    ; [0, 6)
        rdax  h, -2.0
        rdax  h, -2.0
        rdax  h, -2.0
        rdax  h, -2.0
        skp   gez, menos_2
        rdax  hn, -2.0
        rdax  hn, -2.0
        rdax  hn, -2.0
        rdax  hn, -2.0
menos_2:
        rdax  h, -2.0
        rdax  h, -2.0
        skp   gez, menos_1
        rdax  hn, -2.0
        rdax  hn, -2.0
menos_1:
        rdax  h, -2.0
        skp   gez, guardar_x
        rdax  hn, -2.0
guardar_x:
        wrax  x, 1.0
        mulx  disp
        rdax  dmin, 1.0
        sof   -1.0, 0
        rdax  w, 1.0
        wrax  inicio, 0                 ; inicio = w − dmin − x·disp
; ── pareja A: granos 0 y 2 ───────────────────────────────────────────
        rdax  fa, 1.0
        rdax  df, 1.0
        wrax  fa, 1.0
        sof   1.0, -0.5
        skp   neg, a_mitad
        wrax  fa, 0
        rdax  inicio, 1.0
        wrax  p0, 0                     ; el grano 0 empieza
a_mitad:
        clr
        rdax  fa, 1.0
        sof   1.0, -0.25
        skp   neg, a_ventana
        rdax  df, -1.0
        skp   gez, a_ventana
        clr
        rdax  inicio, 1.0
        wrax  p2, 0                     ; el grano 2 empieza
a_ventana:
        clr
        rdax  fa, 1.0
        rdax  fa, 1.0                   ; g = 2·fa
        wrax  t, -1.0
        sof   1.0, 32767/32768          ; 1 − g
        mulx  t
        wrax  t, 1.0
        rdax  t, 1.0
        rdax  t, 1.0
        rdax  t, 1.0                    ; p = 4g(1 − g)
        wrax  t, 0.225
        sof   1.0, 0.775
        mulx  t                         ; s ≈ sin(πg)
        wrax  t, 1.0
        mulx  t
        wrax  t, 0                      ; w0 = s²
        rdaa  p2, 1.0
        wrax  tv, -1.0
        rdaa  p0, 1.0
        mulx  t
        rdax  tv, 1.0
        wrax  suma, 0                   ; v2 + w0·(v0 − v2)
        rdax  p0, 1.0
        rdax  vel, 1.0
        wrax  p0, 0
        rdax  p2, 1.0
        rdax  vel, 1.0
        wrax  p2, 0
; ── pareja B: granos 1 y 3 ───────────────────────────────────────────
        rdax  fb, 1.0
        rdax  df, 1.0
        wrax  fb, 1.0
        sof   1.0, -0.5
        skp   neg, b_mitad
        wrax  fb, 0
        rdax  inicio, 1.0
        wrax  p1, 0                     ; el grano 1 empieza
b_mitad:
        clr
        rdax  fb, 1.0
        sof   1.0, -0.25
        skp   neg, b_ventana
        rdax  df, -1.0
        skp   gez, b_ventana
        clr
        rdax  inicio, 1.0
        wrax  p3, 0                     ; el grano 3 empieza
b_ventana:
        clr
        rdax  fb, 1.0
        rdax  fb, 1.0
        wrax  t, -1.0
        sof   1.0, 32767/32768
        mulx  t
        wrax  t, 1.0
        rdax  t, 1.0
        rdax  t, 1.0
        rdax  t, 1.0
        wrax  t, 0.225
        sof   1.0, 0.775
        mulx  t
        wrax  t, 1.0
        mulx  t
        wrax  t, 0
        rdaa  p3, 1.0
        wrax  tv, -1.0
        rdaa  p1, 1.0
        mulx  t
        rdax  tv, 1.0
        rdax  suma, 1.0
        wrax  suma, 0
        rdax  p1, 1.0
        rdax  vel, 1.0
        wrax  p1, 0
        rdax  p3, 1.0
        rdax  vel, 1.0
        wrax  p3, 0
; ── salida: dos parejas a media escala ≈ la entrada ──────────────────
        rdax  suma, 1.0
        mulx  kwet
        wrax  t, 0
        rdax  adcl, 1.0
        mulx  kdry
        rdax  t, 1.0
        wrax  dacl, 0
        rdax  adcr, 1.0
        mulx  kdry
        rdax  t, 1.0
        wrax  dacr, 0
